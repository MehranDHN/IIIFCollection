fihrist:manuscript_6832 a mdhn:Manuscript ;
    rdfs:label "Persian MS 337" ;
    dct:date "1655 and 1675 CE" ;
    dct:description """The Gospels attributed to the four evangelists Matthew, Mark, Luke,
                            and John, translated into Persian by Flemish Carmelite monk Pierre de la Mère de Dieu
                                (1612–1672) , who apparently completed it in Isfahan at the request of his superior between 1650 to 1655 .
                            French traveller Jean Chardin (1643-1713) , author
                            of Voyages de Monsieur Chardin , probably acquired this
                            volume in Isfahan while residing there between 1673 to
                                1677 , some twenty years after completion of the
                            translation.""" ;
    dct:identifier "manuscript_6832" ;
    dct:language "fa" ;
    dct:spatial "Isfahan" ;
    dct:type "codex" ;
