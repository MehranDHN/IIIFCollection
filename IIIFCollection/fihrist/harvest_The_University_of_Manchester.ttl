fihrist:manuscript_6688 a mdhn:Manuscript ;
    rdfs:label "Persian MS 207" ;
    dct:date "1554" ;
    dct:description """An unillustrated copy of Mihr
                        va-Mushtarī (the Sun and Jupiter), by Muḥammad 'Aṣṣār Tabrīzī (d.
                     ca. 1383). Very neatly written and with magnificent opening illuminated pages,
                     a scribe named Qasim ‘Ali al-Katib completed
                     the volume, probably in the in Safavid
                        Empire , in 962 AH
                        (1554–1555 CE) .""" ;
