fihrist:manuscript_7355 a mdhn:Manuscript ;
    rdfs:label "Persian MS 846" ;
    dct:description """An unsigned, undated complete manuscript of the Dīvān-i Shams-i
                        Tabrīzī , by Jalāl al-Dīn
                        Rūmī, Mawlana, 1207-1273 . Possibly completed in the Indian
                     subcontinent in the 18th century, this clearly-written volume opens with
                     ghazals lyric poems, ends with quatrains, and appears handsomely bound with
                     gilt paper onlays.""" ;
    dct:identifier "manuscript_7355" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
