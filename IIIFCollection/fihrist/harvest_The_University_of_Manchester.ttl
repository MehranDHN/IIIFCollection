fihrist:manuscript_6725 a mdhn:Manuscript ;
    rdfs:label "Persian MS 240" ;
    dct:date "1586-01-17" ;
    dct:description """Author Şem‘ī Şemullah (d. ca. 1602) composed this Ottoman Turkish prose interpretive commentary on the Persian Būstān (Fragrant Orchard), of Saʻdī . Completed by Ibrahīm bin Velī on Friday, end of Muḥarram 994
                        AH (17 Jan 1586 CE) , it would appear to be one of the earliest-known
                     extant copies to survive. British linguist Sir William
                        Jones (1746–1794) possibly acquired the volume while a
                     student.""" ;
    dct:identifier "manuscript_6725" ;
    dct:language "fa" ;
    dct:spatial """Ottoman
                        Empire""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
