fihrist:manuscript_6673 a mdhn:Manuscript ;
    rdfs:label "Persian MS 192" ;
    dct:date """possibly 17th century
                        CE""" ;
    dct:description """This nearly complete manuscript comprises the second volume of the Z̤akhīrah-ʼi Khwārazmshāhī (Treasury of the Khwarazm Shahs) a
                     medical encyclopedia by Ismāʻīl ibn Ḥasan Jurjānī (ca. 1042–1137). It contains
                     the fifth to ninth books, with two appendices on
                     animal ailments and a medical formulary later added by the author. While this volume lacks a colophon, a
                     note by Sir William Jones (1746–1794) declares
                     that former owner Thomas Law (1756–1834) presented it to the Asiatick Society in Calcutta
                     (Kolkata) , between 1784 and 1791 before his return to Britain. While unsigned
                     and undated, the presence of extensive repairs suggests that an unidentified
                     scribe possibly first completed the volume in the Indian
                        subcontinent in the 17th century CE .""" ;
    dct:identifier "manuscript_6673" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
