fihrist:manuscript_7453 a mdhn:Manuscript ;
    rdfs:label "Persian MS 94" ;
    dct:date """983 AH
                           (1575–76 CE)""" ;
    dct:description """al-Risālah
                           al-ʻAlīyah fī al-Aḥādīs̲ al-Nabavīyah (The Sublime Treatise on
                        Prophetic Traditions) composed by Ḥusayn Vāʻiẓ Baihaqi al-Kāshifī. Divided
                        into eight parts, each called an aṣl (pillar), the
                        work discusses forty traditions treating various basic Islamic tenets. On
                        folio 2b , the author dedicates this work to Abī al-Ma‘alī ‘Alī al-Mukhtar al-Nisabah
                           al-‘Ubayd .""" ;
    dct:identifier "manuscript_7453" ;
    dct:spatial """Indian
                           subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
