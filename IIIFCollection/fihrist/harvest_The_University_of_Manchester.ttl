fihrist:manuscript_7137 a mdhn:Manuscript ;
    rdfs:label "Persian MS 635" ;
    dct:description """An abridgment ( Intikhāb ) from the ʿArafāt
                        al-ʿĀshiqīn waʿAraṣāt al-ʿĀrifīn (The Plain of ‘Arafāt of the Lovers
                     and Courts of the Gnostics) by Taqī al-Dīn
                        Awḥadī (d. after 1632-33) . Originally from Isfahan, the author
                     served the Safavid ruler Shāh ʿAbbās I (b. 1571, r. 1588–1629) then later
                     migrated to India where he completed his chronicle for a Mughal court official
                     during the reign of the Emperor Jahāngīr (b. 1569, r. 1605–1627). Undated, but
                     probably originally copied in the 18th century , this incomplete manuscript
                     bears extensive repairs and augmentations by different
                     hands.""" ;
    dct:identifier "manuscript_7137" ;
    dct:language "fa" ;
    dct:spatial """Mughal
                        Empire""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
