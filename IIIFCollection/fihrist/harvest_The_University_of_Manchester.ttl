fihrist:manuscript_7234 a mdhn:Manuscript ;
    rdfs:label "Persian MS 731" ;
    dct:description """This Farasnāmah (Book of Horses) more often appears under
                     a variant title Risālah dar Ṣaydīyah by Shaykh ʿAlī Ḥazīn
                        (d. ca. 1767) . The work contains an introduction on the
                     legality of hunting, followed by the first chapter that presents various land
                     and sea animals by name, a second on their origins, and a third on their senses
                     and faculties. A scribe named Faz̤l Allāh possibly copied this manuscript in the Indian
                        subcontinent during the 18th century
                        CE .""" ;
    dct:identifier "manuscript_7234" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
