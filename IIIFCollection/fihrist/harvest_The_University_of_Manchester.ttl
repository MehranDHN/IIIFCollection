fihrist:manuscript_7070 a mdhn:Manuscript ;
    rdfs:label "Persian MS 572" ;
    dct:date "1800-08-25" ;
    dct:description """The Pandnāmah (Book of Advice), or Karīmā (O Merciful!), a highly-popular book of ethical exhortations and sage advice
                     that while erroneously attributed to Saʻdī (d. 1292), enjoyed broad circulation
                     since at least 150 years after his death. Renowned Delhi scribe
                     Sayyid Abū’l-Ḥasan Raz̤avī (fl. late 18th-early 19th c.), known as 'Mīr
                     Kallan', a leading student of master calligrapher Muḥamamd Ḥafīẓ
                     Khān (d. 1780) completed this small volume in 1800 . Featuring elaborately illuminated opening pages, a stationer-copyist replaced four
                     missing folios before rebinding it in a hybrid British-Indian style.""" ;
    dct:identifier "manuscript_7070" ;
    dct:language "fa" ;
    dct:spatial "Delhi" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
