fihrist:manuscript_7313 a mdhn:Manuscript ;
    rdfs:label "Persian MS 807" ;
    dct:date "1814" ;
    dct:description """The seventh volume of the Rawz̤at al-Ṣafāʼ (Garden of Purity), a general history from the creation of the world to the time of the author, Muḥammad ibn Khāvandshāh (1433–1498) , 
                   known as Mīr Khvānd . 
                   Former owner Sir Gore Ouseley evidently comissioned this volume and Persian MS 808 , 
                   when he served as the British ambassador to Persia between 1810 and 1814 , 
                   in order to finish an incomplete set that he purchased from the estate sale of Captain Archibald Swinton shortly before he departed Britain. 
                   That uniformly bound set of six volumes comprises Persian MS 801 , 802 , 803 , 804 , 805 , and 806 .""" ;
    dct:identifier "manuscript_7313" ;
    dct:language "fa" ;
    dct:spatial "Persia" ;
