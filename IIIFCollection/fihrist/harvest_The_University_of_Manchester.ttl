fihrist:manuscript_7114 a mdhn:Manuscript ;
    rdfs:label "Persian MS 612" ;
    dct:date "the late 18th century" ;
    dct:description """This brief, anonymous, and undated manuscript entitled Risālah-'i
                        Tīrandāzī (Treatise on Archery) probably dates to late 18th-century
                     India. It bears the seal impressions of Awadh rulers Nāṣir al-Dīn Ḥaydar Shāh
                     (r. 1827–1837) and Amjad ‘Alī Shāh (r. 1842–1847), with earlier notations
                     indicate that they likely inherited it from their forebears. The Bodleian
                     Library holds the same text under a variant title, Qānūn-i Tīr
                        Andākhtan (The Rules of Archery, MS Ouseley Add. 68, folios
                     421a–424a) in a composite manuscript entitled Majmu‘ah-'i
                        Rasā'il (Collection of Treatises, See Sachau and Ethe, no. 1241).""" ;
    dct:identifier "manuscript_7114" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
