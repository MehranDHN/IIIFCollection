fihrist:manuscript_6619 a mdhn:Manuscript ;
    rdfs:label "Persian MS 14" ;
    dct:date "1640" ;
    dct:description """This volume of the Dīvān of Ḥāfiẓ (ca. 1315–1390) contains
                     most of the ghazal lyric poems and quatrains typically found in other copies.
                     It also features thirteen commercial illustrations. While the colophon alleges
                     that a scribe and painter named Aḥmad ‘Alī Kashmīrī completed this volume
                     in 1050 AH (1640–1641
                        CE) , the paper for the textblock appears likely manufactured in the
                     late 18th century.""" ;
