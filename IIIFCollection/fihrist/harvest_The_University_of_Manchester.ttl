fihrist:manuscript_6816 a mdhn:Manuscript ;
    rdfs:label "Persian MS 322" ;
    dct:date "1700" ;
    dct:description """The Kalimāt al-Shuʻarāʼ (Discourses of the Poets) by Muḥammad Afz̤al Lāhūrī , pen-named ' Sarkhush ', which he commenced in 1093 AH (1682–83) CE ) based upon a chronogram of the title. 
                     He and his father both served the Mughal emperor Mughal Emperor ‘Alamgīr I . He recounts the lives and works of some 200 Indian poets, especially of Delhi , active during the reign of his patron's predecessors Jahāngīr and Shāh Jahān I , many of whom he knew personally.""" ;
    dct:identifier "manuscript_6816" ;
    dct:language "fa" ;
    dct:spatial "India" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
