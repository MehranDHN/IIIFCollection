fihrist:manuscript_7277 a mdhn:Manuscript ;
    rdfs:label "Persian MS 772" ;
    dct:date "1826-12-22" ;
    dct:description """This volume contains two works concerning Bengal
                     history. The first features the first and third parts of of the Vaqāyi‘-i Mahābat Jang (History of Mahābat
                        Jang , composed by Shāh
                        Muḥammad Vafā' (fl. 18th c.) of ‘Azīmābād
                        (Patna) , which recounts the wars in Bengal that occurred in 1156 AH (1743–44
                        CE) and 1161 AH
                        (1748–49 CE) . A second treatise follows, probably an abridged initial
                     portion of the ‘Ibrat i Arbāb i Baṣar (Lessons of the Lords of
                     Vision) by Rāi Balkund (fl. 18th
                        c.).""" ;
    dct:identifier "manuscript_7277" ;
    dct:language "fa" ;
    dct:spatial "Indian subcontinent" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
