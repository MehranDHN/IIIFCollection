        contrib:manuscript_26514_person_70506082_cataloguer,
        contrib:manuscript_26514_person_f8409_aut_Gaster_MS_Misc_1501_item1,
        contrib:manuscript_26514_person_f8409_scr_Gaster_MS_Misc_1501_item1,
        contrib:manuscript_26514_person_f8410_pat_Gaster_MS_Misc_1501_item1 ;
