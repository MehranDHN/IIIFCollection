fihrist:manuscript_7404 a mdhn:Manuscript ;
    rdfs:label "Persian MS 894" ;
    dct:date "1600" ;
    dct:description """This Dīvān of collected Persian poems by Niẓām
                     al-Dīn Aḥmad Suhaylī (d. either 907 or 918 AH/1501 or 1512 CE) once constituted
                     part of a larger anthology. Unsigned and undated, it bears a delicately
                     illuminated opening header and appears likely likely completed in the sixteenth
                     century. Final final section of riddles ( mu‘ammāt )
                     features lines by other poets. A subsequent owner, possibly Frederick Ayrton (1812–1873) , had
                     it restored, remargined, and rebound in what appears to be an unrelated late
                     fifteenth or early sixteenth-century Egyptian binding and bound as an
                     independent manuscript.""" ;
    dct:identifier "manuscript_7404" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
