fihrist:manuscript_6621 a mdhn:Manuscript ;
    rdfs:label "Persian MS 141" ;
    dct:date """late 18th
                                century CE""" ;
    dct:description """A Latin-Persian miscellany of eight works, all probably copied
                            by—and all but one likely authored by—Autrian orientalist and dragoman Franz Lorenz von Dombay
                            (1758–1810) , who served the Habsburg government as
                            interpreter in Tangier, Madrid, Zagreb and Vienna. Undated, but probably
                            completed in the late 18th century
                            CE .""" ;
