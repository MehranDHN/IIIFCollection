fihrist:manuscript_26546 a mdhn:Manuscript ;
    rdfs:label "Persian MS 946" ;
    dct:description """This manuscript of the Dīvān of Ḥāfiẓ (ca. 1315–1390) in Herat in 937 AH
                        (1530 CE) . This volume features most of the ghazal lyric poems set
                     within lavishly illuminated margins, although it omits quatrains typically
                     found in other copies.""" ;
    dct:identifier "manuscript_26546" ;
    dct:language "fa" ;
    dct:type "codex" ;
