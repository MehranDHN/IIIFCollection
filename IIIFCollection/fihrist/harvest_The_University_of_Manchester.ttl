fihrist:manuscript_14563 a mdhn:Manuscript ;
    rdfs:label "Turkish MS 3" ;
    dct:date "1485" ;
    dct:description """A version in Chagatai Turkish of the love story of Layla and
                            Majnun, by Alî Şîr Nevâʿî of Herat, with two miniatures in the Herat
                            style. It was originally part of a Khamsa (quintet). Other manuscripts
                            from the same set are in the Bodleian Library, these were copied in
                            Afghanistan in 890 AH (1485 CE).""" ;
    dct:identifier "manuscript_14563" ;
    dct:language "chg" ;
    dct:spatial "Afghanistan" ;
    dct:type "codex" ;
