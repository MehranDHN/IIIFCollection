fihrist:manuscript_6844 a mdhn:Manuscript ;
    rdfs:label "Persian MS 348" ;
    dct:description """An unfinished, undated second copy of the Tarjumah-'i Nād Purān (Translation of the Nād Purān ) held in the Rylands (see also Persian MS 347 ). 
                     This Persian translation of an unidentified Sanskrit or Brajbhasha work on music originally entitled Nāda-purāṇa (Ancient Text on Music), describes the musical scales and their qualities, along with a final section on the different rasa (taste, essence, aesthetics) and bhava (expressions) in classical Indian music. 
                     Unlike the other volume, this one features many empty blank spaces that lack illustrative diagrams.""" ;
    dct:identifier "manuscript_6844" ;
    dct:language "fa" ;
    dct:spatial "Indian subcontinent" ;
    dct:type "codex" ;
