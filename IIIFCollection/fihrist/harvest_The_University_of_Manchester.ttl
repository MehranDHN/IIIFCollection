fihrist:manuscript_7349 a mdhn:Manuscript ;
    rdfs:label "Persian MS 840" ;
    dct:date "1634-08-22" ;
    dct:description """This manuscript contains three works, a complete copy of the Dīvān of Bābā Faghānī Shīrāzī (d. 1519) together with the Dīvān of Vaḥshī and an incomplete copy
                     of the latter's romance of Farhād and Shīrīn . A scribe named Muḥammad Ṣadiq completed the volume in the Mughal
                     capital Lahore , on 27 Ṣafar 1044 AH (22 Aug 1634 CE) , to which an
                     illuminator added three elegant headpieces at the start of each work therein.""" ;
    dct:identifier "manuscript_7349" ;
    dct:language "fa" ;
    dct:spatial "Lahore" ;
    dct:type "codex" ;
