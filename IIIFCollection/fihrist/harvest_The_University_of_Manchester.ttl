fihrist:manuscript_7371 a mdhn:Manuscript ;
    rdfs:label "Persian MS 860" ;
    dct:date """1202 AH
                        (1787–1788 CE)""" ;
    dct:description """This Gulistān (Rose Garden) of Saʻdī (ca.
                        1193–1292) opens with lavishly illuminated double-page bears gilt
                     cloudbands surrounding every line of the text on all remaining folios, and
                     still retains an equally lavishly decorated contemporary binding. A scribe
                     named Ḥāfiẓ Muḥammad Khūrshīd completed this
                     manuscript for the Vizier of Awadh under Aṣaf al-Dawlah, Nawwāb Amīr al-Dawla Intiẓām al-Mulk Ḥaydar Bayg Khān Bahādur Nuṣrat Jang
                        (d. 1792) , probably in Lucknow on 1202 AH (1787–1788 CE) .""" ;
    dct:identifier "manuscript_7371" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
