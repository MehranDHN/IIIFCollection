fihrist:manuscript_6605 a mdhn:Manuscript ;
    rdfs:label "Persian MS 127" ;
    dct:date """possibly
                        18th century CE.""" ;
    dct:description """A complete, unillustrated copy of the romance of Yūsuf va
                        Zulaykhā , which comprises the fifth of seven books in the collection
                     entitled Haft Awrang (Seven Thrones) by ‘Abd al-Raḥmān Jāmī (d. 1492) , in 957 AH (1550–51 CE) . A
                     mystical love story of the Prophet
                        Joseph and Potiphar's wife, the author primarily drew inspiration
                     from the twelfth chapter of the Qur'ān Sūrah Yūsuf and
                     also references prior poets. Unsigned and undated, a scribe likely completed it
                     in the Indian subcontinent , possibly during the 18th century
                        CE .""" ;
    dct:identifier "manuscript_6605" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
