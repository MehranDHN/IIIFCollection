fihrist:manuscript_26536 a mdhn:Manuscript ;
    rdfs:label "Persian MS 1017" ;
    dct:description """A copy of the Bahār-i Dānish (Spring of Wisdom) by ʻInāyat
                        Allāh (d. ca. 1671) , relates the romantic adventures of Jahāndār
                     Sulṭān and Bahravar Bānū, which serves as a frame story interwoven with other
                     tales. One of six copies held in the Rylands, this redaction features the
                     preface by the author's younger brother and pupil Muḥammad Ṣāliḥ followed by his own
                     introduction in which he explains how he adapted the tale from one that he
                     heard a young Brahmin recite.""" ;
    dct:identifier "manuscript_26536" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
