fihrist:manuscript_6817 a mdhn:Manuscript ;
    rdfs:label "Persian MS 323" ;
    dct:date "1810-03-10" ;
    dct:description """This composite manuscript contains three ( taẕkīrah ) literary chroncicles in Persian and Urdu. The scribe Shaykh ʿAbd
                        al-Karīm completed the first text, Ikhlāṣ Chand's Hamīshah
                        Bahār (Eternal Spring), in 1136 . The volume also
                     contains Ḥazīn's Taz̲kirah-'i Muʿāṣirīn (Chroncile of
                     Contemporaries), and Qā'im's Makhzan-i Nikāt (Treasury of
                     Witticisms).""" ;
