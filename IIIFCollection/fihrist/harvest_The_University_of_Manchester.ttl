fihrist:manuscript_7460 a mdhn:Manuscript ;
    rdfs:label "Persian MS 97" ;
    dct:date "1840-07-06" ;
    dct:description """A round paper disc of paper card faced with
                     heavily flocked blue on both sides, embossed with a coat of arms surmounted by
                     a crown on the obverse bearing a rose cross and symbols of the Four Evangelists
                     in each corner, and what may be a sacred heart of Jesus design on the reverse,
                     surrounded by partly legible, possible Latin mottos. Wrapped in a folded sheet
                     of paper, it bears a description in the hand of former owner Nathaniel Bland
                     who identifies it as a Specimen of stamped paper found at Fort
                        Hai, Chusan, when that town fell into the hands of the English 6th July 1840 .""" ;
    dct:identifier "manuscript_7460" ;
    dct:language "la" ;
    dct:spatial """Chusan
                        (Zhoushan)""" ;
    dct:type "disc" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
