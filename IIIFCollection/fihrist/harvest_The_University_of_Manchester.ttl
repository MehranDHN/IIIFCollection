fihrist:manuscript_26582 a mdhn:Manuscript ;
    rdfs:label "Persian MS 982" ;
    dct:date """Rajab 1133 AH
                        (Apr.–May 1721 CE)""" ;
    dct:description """Modelled on the Gulistān (Rosegarden) of Sa‘dī, this complete eighteenth-century manuscript of Maʻdin al-Javāhir (The Mine of Jewels) by Mullā Ṭarzī
                     contains 22 chapters and a conclusion ( khāṭimah ) of
                     edifying stories and morals written in prose and verse. The work opens with
                     praise of God, the Prophet, and his patron, the Mughal ruler Jahāngīr and
                     concludes with the author expressing regret for his choice of title and humbly
                     asking for forgiveness in the afterlife (fol. 1037b). A chronogram indicates
                     that the author completed it for his patron in 1025 AH (1616–1617
                        CE) . A scribe named ‘Abdul
                        Raḥmān Ṣadīqī completed this volume on Rajab 1133 AH (Apr.–May
                        1721 CE) .""" ;
    dct:identifier "manuscript_26582" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
