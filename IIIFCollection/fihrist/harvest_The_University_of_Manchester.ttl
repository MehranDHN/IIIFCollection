fihrist:manuscript_7029 a mdhn:Manuscript ;
    rdfs:label "Persian MS 533" ;
    dct:description """An illuminated and illustrated Safavid-era copy of the Subḥat
                        al-Abrār (Rosary of the Pious) composed by Timurid-era poet ‘Abd al-Raḥmān Jāmī (d. 1492) comprises
                     the fifth of seven books in his collection entitled Haft Awrang (Seven Thrones). Unsigned and undated, but seemingly complete, it contains four
                     Safavid-era illustrations which suggest that commercial artists in Shiraz possibly completed the volume in the late 16th
                        century CE""" ;
    dct:identifier "manuscript_7029" ;
    dct:language "fa" ;
    dct:spatial "Shiraz" ;
    dct:type "codex" ;
