fihrist:manuscript_6988 a mdhn:Manuscript ;
    rdfs:label "Persian MS 492" ;
    dct:date "mid-18th century." ;
    dct:description """The Risālah-i Yuḥanna-yi Isrā’īl (Treatise of Yuḥanna of
                     Israel) contains six chapters on the rightousness of Shi’ism based upon the
                     Qur'ān, traditions of the Prophet and the Imams, and commentators. Author
                     Yuhanna Isra’il argues how after studying the doctrines of various sects,
                     he adopted Shi’ism. Apparently originally the first text in a collection of
                     treatises, with the other titles recorded in a different hand, on folio 1a .""" ;
    dct:identifier "manuscript_6988" ;
    dct:language "fa" ;
    dct:spatial "Indian subcontinent" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
