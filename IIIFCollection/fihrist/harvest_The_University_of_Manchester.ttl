fihrist:manuscript_7357 a mdhn:Manuscript ;
    rdfs:label "Persian MS 848" ;
    dct:date "1688-12-10" ;
    dct:description """This copy of the Mas̲navī-i Ma‘navī (Spiritual Couplets)
                     by Jalāl
                        al-Dīn Rūmī (1207–1273) contains six illuminated headers
                     indicating the start of each of book within the volume. A scribe named Ni‘mat
                        Khān copied this volume over five months in Kasur,
                        Punjab , where he finished it on 6
                        Rajab 1079 AH (10 Dec. 1688) .""" ;
    dct:identifier "manuscript_7357" ;
    dct:language "fa" ;
    dct:spatial """Kasur,
                        Punjab""" ;
