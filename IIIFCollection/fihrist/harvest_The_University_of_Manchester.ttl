fihrist:manuscript_26552 a mdhn:Manuscript ;
    rdfs:label "Persian MS 952" ;
    dct:date "15th to 16th centuries CE" ;
    dct:description """A Persian inscription on the first right
                                flyleaf a side (f. ia) identifies this incomplete dictionary
                            as the Jāmi‘ al-Lughāt (Assembly of Languages) and
                            ascribes the work to one Qamar al-Dīn
                                Ḥusyanī , while another in English vaguely describes it as Arabic explained, Persian . The text regrettably
                            lacks both the opening and a significant number of final pages, but on
                            the basis of the script style, extensive damage, and numerous historical
                            appears, it may possibly date to the 15th–16th century CE.""" ;
    dct:identifier "manuscript_26552" ;
    dct:language "fa" ;
    dct:spatial "Indian subcontinent" ;
    dct:type "codex" ;
