fihrist:manuscript_6728 a mdhn:Manuscript ;
    rdfs:label "Persian MS 243" ;
    dct:date """late 17th to early
                        18th century""" ;
    dct:description """This undated abridgement of the Dīvān-i Shams-i Tabrīzī by Jalāl al-Dīn
                        Rūmī contains roughly 600 ghazal lyric poems. While it omits
                     stanzaic poems and quatrains typically found in the full version of the work,
                     this manuscript includes verses not found in standard editions.""" ;
    dct:identifier "manuscript_6728" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
