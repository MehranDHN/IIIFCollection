fihrist:manuscript_6724 a mdhn:Manuscript ;
    rdfs:label "Persian MS 24" ;
    dct:date """late 15th
                                century CE""" ;
    dct:description """This early manuscript of Mihr va Mushtarī (Sun and
                            Jupiter), the tale of Mihr, son of Shāhpūr, and his vizier's son
                            Mushtarī by Muḥammad 'Aṣṣār Tabrīzī (d. ca.
                                1383) , opens with a double-page frontispiece that
                            portrays a princely hunting scene and features five other illustrations.
                            The date in the colophon, 10 Muḥarram 788 AH (11 Feb. 1386 Julian) ,
                            is for when the author first completed the text, not this manuscript,
                            which instead appears to date about a century later.""" ;
    dct:identifier "manuscript_6724" ;
    dct:language "fa" ;
    dct:spatial "Greater Iran" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
