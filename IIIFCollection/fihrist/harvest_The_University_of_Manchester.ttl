fihrist:manuscript_6720 a mdhn:Manuscript ;
    rdfs:label "Persian MS 236" ;
    dct:date """18th century
                        CE""" ;
    dct:description """This nearly complete, unsigned, and undated copy of the Mas̲navī-i Ma‘navī (Spiritual Couplets) by Jalāl
                        al-Dīn Rūmī (1207–1273) contains all six books but omits all preceding prefaces. An anonymous
                     scribe originally wrote all 30,265 couplets over the centres of pages
                     previously masked off and finely sprayed with gold ink ( ghubār ), to which illuminators
                     then added the surrounding gold marginal ruling illuminated headers at the start of each book. Extensive repairs and blank
                     pages between each book suggest the scribe likely originally completed six
                     separate volumes that a subsequent owner had restored and rebound together
                     as one volume.""" ;
    dct:identifier "manuscript_6720" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_6720_person_120696480_ato,
