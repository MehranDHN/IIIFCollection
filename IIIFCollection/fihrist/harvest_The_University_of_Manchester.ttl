fihrist:manuscript_6642 a mdhn:Manuscript ;
    rdfs:label "Persian MS 160" ;
    dct:date """late 18th to early
                        19th centuries CE""" ;
    dct:description """This undated copy of the Vāqi‘āt-i Bāburī (Events of
                     Bābur), the memoirs of Bābur (b.
                        1483, r. 1526–1530 , founder of the Mughal dynasty in India,
                     appear complete and well-written. Originally composed by him in Chagatai
                     Turkish, the Mughal nobleman ‘Abd al-Raḥīm Khān, Khān-i Khānān
                        (1556–1627) completed this paraphrased Persian translation in 998 AH (1590 CE) and presented it to the subject's grandson,
                     the Emperor Akbar. The text commences in Ramaẓān
                        899 AH (June 1494 CE) with events during Bābur's brief reign in the Fergana
                        Valley .""" ;
    dct:identifier "manuscript_6642" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
