fihrist:manuscript_26544 a mdhn:Manuscript ;
    rdfs:label "Persian MS 944" ;
    dct:date "1600" ;
    dct:description """An beautifully copied and lavishly illuminated unillustrated copy of the Silsilat al-Ẕahab (Golden Chain), first of seven books from
                     the Haft Awrang (Seven Thrones) by the late Timurid-era poet ‘Abd al-Raḥmān Jāmī (d. 1492) . A Safavid
                     calligrapher Muḥammad Qavvām Shīrāzī
                        (fl. early 17th c.) probably completed this undated volume in
                     Shiraz in the early 17th century.""" ;
    dct:identifier "manuscript_26544" ;
    dct:language "fa" ;
    dct:spatial "Shiraz" ;
    dct:type "codex" ;
