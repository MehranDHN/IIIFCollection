fihrist:manuscript_13824 a mdhn:Manuscript ;
    rdfs:label "Indian Drawings 6" ;
    dct:date "late 18th century CE" ;
    dct:description """This Persianate South Asian album preserves facing portraits mainly
                            completed by the same painter Nahīkā
                                Khān , along with several other unsigned examples. Most
                            images bear captions indicating specific people and their occupations.
                            As such, it presents something of a visual shahr-i
                                āshūb (devastated town), a tour of a town and its inhabitants.
                            The long gowns worn by most subjects suggests that the album probably
                            originated in the Carnatic, during the late 18th century. The volume
                            retains its original binding, with a prominent unidentified monogram H on the left
                                cover exterior .""" ;
    dct:identifier "manuscript_13824" ;
    dct:language "fa" ;
    dct:spatial "Indian subcontinent" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
