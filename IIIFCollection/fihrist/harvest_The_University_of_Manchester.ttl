fihrist:manuscript_7146 a mdhn:Manuscript ;
    rdfs:label "Persian MS 644" ;
    dct:date """Saturday, 14
                        Jumādá II 1169 AH (16 March 1756 CE)""" ;
    dct:description """This undated, incomplete composite manuscript, written in multiple hands,
                     contains many extracts of verse selected from the works of medieval and early
                     modern poets. The names of the poets are given in black ink in the top right
                     hand corner of each page. It also contains various other passages of ornate
                     prose (folios 33a–37a), horoscopes for newborn children (folios 3a, 45a), Munājāt (Whispered Prayers) by ʿAbd Allāh Anṣārī (folios
                     19b-23a), and an unidentified diary entry (folio 32b). Albeit undated, and with
                     more than half of the folios now apparently missing, three vermilion library
                     seals of the kings of Awadh (Oude) attest to their ownership in the early to
                     mid 19th century.""" ;
    dct:identifier "manuscript_7146" ;
    dct:language "fa" ;
    dct:spatial """Awadh
                        (Oude)""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
