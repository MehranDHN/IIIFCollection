fihrist:manuscript_14376 a mdhn:Manuscript ;
    rdfs:label "Arabic MS 676" ;
    dct:date """around
                  1660""" ;
    dct:description """Composite manuscript containing a treatise on the Arabic musical tunes by
              Muẓaffar ibn al-Ḥusain ibn al-Muẓaffar al-Ḥaṣkafi entitled Risālat al-Kashīf fī
                ʿIlm al-Anghām (The Treatise of the Discoverer in the Science of Melodies),
              and an astrolomical treatise entitled Ẓuhūr ath-Thariyyā wa-Khafāʿ ma kān
                wabiyya (The Appearance of the Pleiades and the Disappearance of the
              Plague-stricken) by Ottoman astronomer Sulaymān ibn Ḥamzah ibn Ḥashīsh.""" ;
