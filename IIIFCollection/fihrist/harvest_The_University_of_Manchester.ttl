fihrist:manuscript_26530 a mdhn:Manuscript ;
    rdfs:label "Persian MS 1011" ;
    dct:description """Shāhnāmah (Book of Kings), by Abū al-Qāsim
                                Manṣūr Firdawsī (fl. ca. 940–1020) . It opens with a
                            shortened redaction of the Baysunghur preface, followed by the poem
                            proper, of which Abū Manṣūr Daqīqī (d. ca. 980) commenced a thousand
                            lines, but after his death, Firdawsī completed the work shortly before
                            the year 1000 CE . He drew
                            upon a number of pre-Islamic Pahlavi middle Persian sources, principally
                            the now-lost Khwadāynāmag (Book of Lords) that recounted
                            the ancient rulers of Persian until the Sassanian period, as well as
                            Iranian mythology and folklore. Previously held in Chetham's Library, Manchester.""" ;
    dct:identifier "manuscript_26530" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_26530_person_101359236_aut_Persian_MS_1011_item1,
        contrib:manuscript_26530_person_155994771_rps,
        contrib:manuscript_26530_person_22161693743415930845_cataloguer,
        contrib:manuscript_26530_person_236148120616594790666_ctb_Persian_MS_1011_item1 ;
    mdhn:hasItem item:manuscript_26530_Persian_MS_1011_item1 ;
    mdhn:hasSubject fihrist:subject_sh85044286,
        fihrist:subject_sh85044293,
        fihrist:subject_sh85100085 ;
    mdhn:heldAt glam:The_University_of_Manchester_The_John_Rylands_Research_Institute_and_Library ;
    mdhn:heldBy glam:The_University_of_Manchester ;
