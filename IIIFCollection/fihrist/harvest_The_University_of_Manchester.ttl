fihrist:manuscript_13821 a mdhn:Manuscript ;
    rdfs:label "Persian MS 765" ;
    dct:date "1692-07-31" ;
    dct:description """An incomplete, possibly 18th-century copy of the Mukātabāt-i ʻAllāmī (Writings of ‘Allāmī) contains
                            correspondence of Persian émigré and eventual minister to the Mughal
                            emperor Akbar, Abū al-Faz̤l ibn Mubārak
                            (1551–1602) , posthumously compiled by his nephew, ʻAbd al-Ṣamad ibn Afz̤al Muḥammad (fl.
                                early 17th c) in 1015 AH (1606-07 CE) . The latter
                            divided the work into three books (daftars): letters that Abu'l Fazl
                            drafted in Akbar's name, correspondence that he himself wrote to Akbar
                            and other nobility, and miscellaneous letters and prose pieces.""" ;
    dct:identifier "manuscript_13821" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_13821_person_22161693743415930845_cataloguer,
