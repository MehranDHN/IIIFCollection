fihrist:manuscript_7112 a mdhn:Manuscript ;
    rdfs:label "Persian MS 610" ;
    dct:description """Risālah dar Ṣaydīyah , (Treatise on Hunting) a zoological work by Muḥammad bin Abī Ṭalib Zāhidī Jīlānī , whom many identify as Shaykh ʿAlī Ḥazīn
                        (d.1180/1766-7) . The work contains an introduction on the
                     legality of hunting, followed by the first chapter that presents various land
                     and sea animals by name, a second on their origins, and a third on their senses
                     and faculties.""" ;
    dct:identifier "manuscript_7112" ;
    dct:language "fa" ;
    dct:spatial "India" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
