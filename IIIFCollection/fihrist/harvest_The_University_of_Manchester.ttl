fihrist:manuscript_26540 a mdhn:Manuscript ;
    rdfs:label "Persian MS 637" ;
    dct:date """17th century
                            CE""" ;
    dct:description """This poetic anthology entitled Qaṣāyid Asatiẕā (Odes of the Masters) contains primarily religious poetry by Ḥasan Kashānī Āmulī . It opens with his Haft Band (Seven Strophes), and ends with a
                            Vaṣīyat'nāmah of Fāṭimah.""" ;
