fihrist:manuscript_6842 a mdhn:Manuscript ;
    rdfs:label "Persian MS 346" ;
    dct:description """Two texts on musicology bound together: Shams al-Aṣvāt (Sun of Songs, albeit here entitled Dar ‘Ilm-i Musīqī , On
                     Musicology), and Ḥayy al-Arvāḥ (Life of the Souls) by amateur
                     musician Mīyān Zīyā al-Dīn, pen-named 'īyā', with various instruments drawn in
                     the margins.""" ;
