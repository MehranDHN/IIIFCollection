fihrist:manuscript_26563 a mdhn:Manuscript ;
    rdfs:label "Persian MS 963" ;
    dct:date """18th
                     century""" ;
    dct:description """An incomplete illustrated illuminated volume of the romance of Yūsuf va Zulaykhā , a mystical love story inspired
                     by the biblical tale of Joseph and Potiphar's wife, by the late Timurid-era
                     poet ‘Abd al-Raḥmān Jāmī (1414–1492) . The
                     author primarily drew inspiration from the twelfth chapter of the Qur'ān Sūrah Yūsuf and references by prior poets. It also
                     constitutes the fifth of seven major works by the author within the collection
                     entitled Haft Awrang (Seven Thrones). Possibly completed in the""" ;
    dct:identifier "manuscript_26563" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
