fihrist:manuscript_7191 a mdhn:Manuscript ;
    rdfs:label "Persian MS 688" ;
    dct:date "1604-08-13" ;
    dct:description """This work entitled ʻImād-i Subḥānīyah dar
                        ‘Ilm-i Suluk (Pillar of Praise in the Science of the Seekers),
                     appears to contain just the first three of four chapters of the work better
                     known as the Junūn al-Majānīn (Lunacy of
                     the Mad). Composed by the author, Qivām
                        al-Dīn Muḥammad ibn ʻImād Sanjānī (d. 1418) in 770 AH (1368 CE) , in the work,
                     he stridently critiques what he deems unorthodox, extremist tendencies of some
                     Sufis, a position for which later figures such as Jāmī praise him. This volume,
                     completed by a likely Mughal-era scribe named Muḥammad ibn Jalāl Shāh Chishtī al-Sarhindī in 17 Rabī‘ I 1013 AH (13 Aug. 1604
                        CE) .""" ;
    dct:identifier "manuscript_7191" ;
    dct:language "fa" ;
    dct:spatial "Mughal Empire" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
