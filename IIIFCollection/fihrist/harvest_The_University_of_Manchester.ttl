fihrist:manuscript_7340 a mdhn:Manuscript ;
    rdfs:label "Persian MS 832" ;
    dct:date """possibly 18th century
                        CE""" ;
    dct:description """A complete manuscript of the Mīr'āt al-Quds (Holy Mirror)
                     a life of Jesus Christ by Geronimo
                     Xavier rendered into Persian with the assistance of Mullā ʻAbd al-Sattār at Agra (India) in 1602 by order of the Mughal
                     ruler Emperor Akbar (b. 1542, r.
                        1554–1605) . Unsigned and undated, evidence of significant
                     readership and damage suggest that an unidentified scribe completed the volume
                     in the Indian subcontinent , possibly in the 18th century CE .""" ;
    dct:identifier "manuscript_7340" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
