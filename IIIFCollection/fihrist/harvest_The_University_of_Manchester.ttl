fihrist:manuscript_6701 a mdhn:Manuscript ;
    rdfs:label "Persian MS 219" ;
    dct:date "1199 AH (1784–85 CE)" ;
    dct:description """The author of this valuable holograph copy of this Dīvān , Mīrzā Zayn al-Dīn Khān (fl. mid-17th century), pen-named
                     'ʿIshq', presented this volume to the Governor-General of Bengal Sir
                        John Macpherson (1745–1821) . The poet details how he travelled
                     extensively and worked in various locations throughout the subcontinent during
                     his lifetime. He also unusually indicates the metres, where and when he
                     composed many poems, and also highlights intertextual connections with the
                     works of other poets.""" ;
    dct:identifier "manuscript_6701" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
