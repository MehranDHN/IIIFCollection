fihrist:manuscript_26575 a mdhn:Manuscript ;
    rdfs:label "Persian MS 975" ;
    dct:date "before 1772" ;
    dct:description """This Arabic Muʻallaqāt (Suspended Odes) by seven
                            pre-Islamic Arabic poets, allegedly written on cloth then displayed upon
                            the Ka‘bah contains an anonymous interlinear Persian translation and
                            commentary. Complete, albeit unsigned and undated, an unidentified
                            scribe copied it on British-manufactured handmade paper watermarked J. Bigg manufactured by Iping, West Sussex papermaker John Bigg (fl. 1746–1772) , which indicates the
                            manuscript must date roughly to the third quarter of the 18th
                            century.""" ;
    dct:identifier "manuscript_26575" ;
    dct:language "fa" ;
    dct:type "codex" ;
