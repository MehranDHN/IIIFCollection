fihrist:manuscript_7392 a mdhn:Manuscript ;
    rdfs:label "Persian MS 88" ;
    dct:date "1815-10-18" ;
    dct:description """A copy of the Bahār-i Dānish (Spring of Wisdom) authored
                     by ʻInāyat
                        Allāh (d. ca. 1671) in 1061 AH (1651 CE) during the reign of the Mughal ruler Shāh Jahān (1592–1666, r. 1626–1658) , relates the
                     romantic adventures of Jahāndār Sulṭān and Bahravar Bānū, which serves as a
                     frame story interwoven with other tales. One of six copies held in the
                     Rylands, this redaction contains a preface by the author's younger brother and
                     pupil Muḥammad Ṣāliḥ followed by
                     the author's own introduction in which he explains how he adapted the tale from
                     one that he heard a young Brahmin recite. An unidentified scribe completed this
                     volume, probably in the Indian
                        subcontinent on 14 Zī-al-Qa‘dah 1230 AH (18 Oct. 1815) .""" ;
    dct:identifier "manuscript_7392" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_7392_person_118508080_edt,
        contrib:manuscript_7392_person_17950016_aut_Persian_MS_88_item1,
