fihrist:manuscript_26593 a mdhn:Manuscript ;
    rdfs:label "Persian MS 993" ;
    dct:description """This anonymous work entitled Dastān Sayyid Maḥmūd ,
                            (Story of Sayyid Maḥmūd) appears likely completed in 19th-century
                            Qājār-era Irān. Clearly written on every other folio, with ink transfer
                            on the blank pageopposite suggests the author employed the blank pages
                            as blotting paper, and did not fill the entire volume. The exterior
                            cover bears the title Sultanpur , but this appears
                            unrelated to the text. It suggests that the volume may have originated
                            as a decorated blank book that the author coopted to write this
                            story.""" ;
    dct:identifier "manuscript_26593" ;
    dct:language "fa" ;
    dct:spatial "Greater Iran" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
