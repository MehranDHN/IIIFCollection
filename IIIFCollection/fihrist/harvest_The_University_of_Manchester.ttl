fihrist:manuscript_7235 a mdhn:Manuscript ;
    rdfs:label "Persian MS 732" ;
    dct:date """late 18th to early
                        19th centuries CE""" ;
    dct:description """This incomplete manuscript of the Rāḥat al-Farās (Comfort
                     of Horses) by Anand Rām Mukhliṣ (ca. 1699–1751) features
                     four lively illustrations. While unsigned and undated, it opens with an
                     illuminated header and seals of the royal library of Awadh in Lucknow .""" ;
