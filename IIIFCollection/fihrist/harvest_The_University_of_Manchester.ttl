fihrist:manuscript_6667 a mdhn:Manuscript ;
    rdfs:label "Persian MS 187" ;
    dct:description """This incomplete copy of the romance of Farhād va Shīrīn by
                     Vaḥshī Bāfqī (d. 1583), ends at the 23rd of 44 parts. The author modelled it
                     upon the earlier work on the same theme by the poet Niẓāmī , which left incomplete at his death. Nevertheless,
                     it proved immensely popular and many consider it Vaḥshī's masterpiece. This
                     manuscript formerly belonged to Sir William Jones (1746–1794) , who made
                     many notes therein. It appears that he probably commissioned his friend Bahman, son of Bahman, son of
                        Isfandiyar (d. 1788) to copy this volume during his tenure in
                     Calcutta.""" ;
    dct:identifier "manuscript_6667" ;
    dct:language "fa" ;
    dct:spatial """Calcutta
                     (Kolkata)""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
