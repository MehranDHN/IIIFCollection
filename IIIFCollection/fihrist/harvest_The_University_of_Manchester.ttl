fihrist:manuscript_7375 a mdhn:Manuscript ;
    rdfs:label "Persian MS 864" ;
    dct:description """The Tuḥfat al-Ḥabīb (Gift of the Friend), an
                     alphabetically arranged anthology of ghazal lyric poems
                     from the 13th to early 16th centuries CE. Compiled by Safavid-era poet Fakhrī
                     Haravī (ca. 1497–1566), pen-named Amīrī , he
                     dedicated it to his patron, then-governor of Herat, Karīm al-Dīn Khvājah Ḥabīb Allāh Savājī (fl. early 16th
                        c) . Albeit undated and probably incomplete, this finely copied
                     manuscript bears a illuminated header and appears likely completed in the
                     Mughal empire.""" ;
    dct:identifier "manuscript_7375" ;
    dct:language "fa" ;
    dct:spatial """Mughal
                        Empire""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
