fihrist:manuscript_26545 a mdhn:Manuscript ;
    rdfs:label "Persian MS 945" ;
    dct:description """An unidentified scribed finished this nearly complete Dīvān of Ḥāfiẓ (ca. 1315–1390) in Herat in 937 AH
                        (1530 CE) . This volume contains most of the ghazal lyric poems but
                     omits quatrains typically found in other copies. It also features a lavishly
                     illuminated opening folios, headers, and margins, as well as four illustrations.""" ;
    dct:identifier "manuscript_26545" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
