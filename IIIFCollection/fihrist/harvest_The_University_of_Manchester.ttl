fihrist:manuscript_26515 a mdhn:Manuscript ;
    rdfs:label "Gaster MS Misc 1519" ;
    dct:date """18th or 19th
                                century""" ;
    dct:description """This incomplete, illustrated Persian translation of the Kitāb Suwar Kawākib al-Thābitah (Book of Forms
                            of the Fixed Stars), composed in Arabic by ‘Abd al-Raḥman al-Ṣūfī (ca. 903–986) . It features thirty-two
                            depictions of the zodiac and other constellations, together with
                            unidentified tables, and possibly dates to the eighteenth or nineteenth
                            centuries. The Persian headings derive from Naṣr al-Dīn al-Tūsī's redaction, while the tables appear to comport with those of Ūlūgh Bayg.""" ;
    dct:identifier "manuscript_26515" ;
    dct:language "fa" ;
    dct:spatial """Greater
                                Iran""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
