fihrist:manuscript_7330 a mdhn:Manuscript ;
    rdfs:label "Persian MS 822" ;
    dct:date """probably 18th century
                        CE""" ;
    dct:description """A complete copy of the Muntakhab al-Lubāb (Selections of
                     the Intellects) by Muḥammad Hāshim Khāfī Khān (ca. 1663–1731). Comprised of
                     three books, the first covers pre-Mughal dynasties up to the Lodi Sultanate.
                     The second relates the history of the Timurid dynasty and their Mughal
                     descendants up to the reign of Emperor Akbar, including the Sur interregnum;
                     The third volume covers the reigns of Jahangīr to the 14th year of the reign of Muḥammad Shāh (b. 1702, r.
                        1719–1748) , in 1742. Since the events he records from 1669 to
                     1742 reflect his own experiences and events that he personally witness,
                     historians deem it an invaluable source on the later Mughal period.""" ;
    dct:identifier "manuscript_7330" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
