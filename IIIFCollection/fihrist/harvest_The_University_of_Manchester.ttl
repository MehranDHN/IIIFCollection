fihrist:manuscript_26518 a mdhn:Manuscript ;
    rdfs:label "Persian MS 999" ;
    dct:description """The first of two volumes of an incomplete Shāhnāmah (Book of
                            Kings), by Abū al-Qāsim Manṣūr
                                Firdawsī (fl. ca. 940–1020) , together with Persian MS 1000 . It opens with a shortened
                            redaction of the Baysunghur preface, followed by the poem proper, of
                            which Abū Manṣūr Daqīqī (d. ca. 980) commenced a thousand lines, but
                            after his death, Firdawsī completed the work shortly before the year 1000 CE . He drew upon
                            a number of pre-Islamic Pahlavi middle Persian sources, principally the
                            now-lost Khwadāynāmag (Book of Lords) that recounted the
                            ancient rulers of Persian until the Sassanian period, as well as Iranian
                            mythology and folklore.""" ;
    dct:identifier "manuscript_26518" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_26518_person_101359236_aut_Persian_MS_999_item2,
        contrib:manuscript_26518_person_155994771_rps,
        contrib:manuscript_26518_person_22161693743415930845_cataloguer,
        contrib:manuscript_26518_person_29301023_ant_Persian_MS_999_item2,
        contrib:manuscript_26518_person_f4076_aut_Persian_MS_999_item1 ;
    mdhn:hasItem item:manuscript_26518_Persian_MS_999_item1 ;
    mdhn:hasSubject fihrist:subject_sh85044286,
        fihrist:subject_sh85100085 ;
    mdhn:heldAt glam:The_University_of_Manchester_The_John_Rylands_Research_Institute_and_Library ;
    mdhn:heldBy glam:The_University_of_Manchester ;
    mdhn:inCollection "Persian Manuscripts" ;
