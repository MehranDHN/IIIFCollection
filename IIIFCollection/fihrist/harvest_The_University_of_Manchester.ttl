fihrist:manuscript_6852 a mdhn:Manuscript ;
    rdfs:label "Persian MS 355" ;
    dct:date """items variously dated to the late 18th and early 19th
                     century""" ;
    dct:description """The first of three volumes of poetical English translations from Persian
                     by British poet, orientalist, and painter, Charles Fox
                        (1749–1809) , together with Persian MS
                           356 and 357 . After
                     his death, his friend Rev. Adam Clarke (1762–1832) apparently obtained disparate notes by Fox and had them uniformly bound up as a
                     set. Many entries contain references to the manuscripts that Fox studied with
                     occasional dates. This volume contains metrical English translations of ghazals
                     by the poet Ḥāfiẓ .""" ;
    dct:identifier "manuscript_6852" ;
    dct:language "en" ;
    dct:spatial "Bristol" ;
    dct:type "codex" ;
