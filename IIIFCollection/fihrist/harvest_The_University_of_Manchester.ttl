fihrist:manuscript_7144 a mdhn:Manuscript ;
    rdfs:label "Persian MS 642" ;
    dct:date "1237 AH (1821–22 CE)" ;
    dct:description """An elegant oblong anthology, which the scribe, ʿĀlījāh Kashmīr Khān (fl. early 19th c.) , describes as a bayāz̤ in the colophon, derived from the Arabic term for white. 
                     It contains mostly of narrative verses by late medieval and early modern poets such as Jāmī , Nawʿī , and Mīrzā Ṣādiq Tafrīshī , among others, as well as a prose text at the end entitled Ḥikāyat-i Duzd va Qāz̤ī (Story of the Thief and the Judge).
                     The scribe completed this manuscript in 1237 AH (1821-22 CE) , apparently  on behalf of his patron, the ruler of the parganah of Malagarh (Balagarh) Nawwāb Bahādur Khān (d. 1824) .""" ;
    dct:identifier "manuscript_7144" ;
    dct:language "fa" ;
    dct:spatial "Malagarh (Balagarh), India" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
