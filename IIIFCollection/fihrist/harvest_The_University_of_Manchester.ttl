fihrist:manuscript_6790 a mdhn:Manuscript ;
    rdfs:label "Persian MS 3" ;
    dct:date "1632-06-30" ;
    dct:description """A Persian translation of the ʻAjā’ib al-Makhlūqāt va
                                Gharāʼib al-Mawjūdāt (Wonders of Creation and Oddities of
                            Existence), Qazvīnī's famous medieval Arabic cosmography. Completed by Shūmā on 12 Ẕū-al-Ḥijjah 1041 AH
                                (30 Jun. 1632 CE) on various tinted papers, the volume also
                            features 355 Isfahan style
                            illustrations.""" ;
    dct:identifier "manuscript_6790" ;
    dct:language "fa" ;
    dct:spatial "Isfahan" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
