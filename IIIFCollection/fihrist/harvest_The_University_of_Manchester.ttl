fihrist:manuscript_6800 a mdhn:Manuscript ;
    rdfs:label "Persian MS 308" ;
    dct:description """This extremely rare, nearly complete volume entitled Lubāb
                        al-Albāb (Kernels of the Intellects) by Sadīd al-Dīn Muḥammad ʻAwfī
                     (fl. 1228) comprises the earliest-known anthology of Persian poetry. He
                     composed it in two parts with twelve sections in which he compiles
                     biolgraphical accounts of many early poets and contemporaries authors, together
                     with selections of their works, unrecorded in other sources. The author
                     apparently commenced the work at the request of the Ghurid-era governor of Multan , Nāṣir al-Dīn Qabāchah (fl. 1203–1228) and
                     completed it in 618 AH (1221–22 CE) .""" ;
    dct:identifier "manuscript_6800" ;
    dct:language "fa" ;
    dct:spatial "India" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
