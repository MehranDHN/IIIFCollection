fihrist:manuscript_7015 a mdhn:Manuscript ;
    rdfs:label "Persian MS 520" ;
    dct:date """end of
                        Jumādà I 989 (beg. Jul. 1581 CE)""" ;
    dct:description """This complete copy of the Tuḥfat al-Aḥrār (Gift of the
                     Noble) composed by Timurid-era poet ‘Abd al-Raḥmān
                        Jāmī (d. 1492) comprises the fifth of seven books in his
                     collection entitled Haft Awrang (Seven Thrones). A Safavid-era
                     scribe named Muḥammad bin Mullā Mīr al-Ḥusaynī
                        al-Ustādī completed this lavishly illuminated manuscript at the end of
                        Jumādà I 989 (beg. Jul. 1581 CE) . It subsequently made its way to
                     volume bears many seal impressions and notations indicating that it was
                     formerly held in the royal library of the Kings of Awadh in Lucknow .""" ;
    dct:identifier "manuscript_7015" ;
    dct:language "fa" ;
    dct:spatial """Safavid
                        Empire""" ;
