fihrist:manuscript_26584 a mdhn:Manuscript ;
    rdfs:label "Persian MS 984" ;
    dct:date "1357-01-02" ;
    dct:description """This 14th-century volume of the Mas̲navī-i Ma‘navī (Spiritual Couplets) by Jalāl al-Dīn Rūmī (1207–1273), contains all six books
                     but lacks an opening preface. A scribe named Maḥmūd ibn Mubārak completed it in 9 Muḥarram 758 AH (2 January 1357
                        CE) , about 85 years after the author first composed it. Therefore,
                     it not only constitutes the earliest example of this work held in the Rylands, but also among the most significant copies in Britain.""" ;
    dct:identifier "manuscript_26584" ;
    dct:language "fa" ;
    dct:type "codex" ;
