fihrist:manuscript_26554 a mdhn:Manuscript ;
    rdfs:label "Persian MS 954" ;
    dct:date "1804-05-25" ;
    dct:description """The Jahān-i Dānis̲h̲ (World of Wisdom), an
                            astronomical and geographical text completed by 12th-century scholar
                            S̲h̲araf al-Dīn Muḥammad bin Masʿūd al-Masʿūdī, which he translated into
                            Persian from his now-lost Arabic version, al-Kifāyah fī ʿilm
                                haiʾat al-ʿālam . He divides the work into two essays ( maqālah ) 'Dar bayān-i tarkīb-i aflāk', in
                            twenty-three chapters, (bāb), and the second, 'Dar bayān-i haiʾat-i
                            zamīn' in fourteen bābs. An unidentified scribe completed this volume in 14 Ṣafar 1219 AH
                                (25 May 1804 CE)""" ;
    dct:identifier "manuscript_26554" ;
    dct:language "fa" ;
    dct:type "codex" ;
