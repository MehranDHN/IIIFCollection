fihrist:manuscript_13826 a mdhn:Manuscript ;
    rdfs:label "Indian Drawings 12" ;
    dct:date """circa 1773–1780
                                CE""" ;
    dct:description """Album of forty-two folios (originally forty) that feature Persian
                            and South Asian paintings and calligraphy, assembled for Swiss mercenary Colonel Antoine-Louis-Henri
                                Polier (d. 1795) , probably at Lucknow and overseen by artist Mihr Chand , between 1780 to 1787 .
                            Titled Volume quatorsieme (Volume 14), it is one of twenty-one of
                            Polier's albums that survive today.""" ;
    dct:identifier "manuscript_13826" ;
    dct:language "ar",
        "fa" ;
    dct:spatial "Lucknow" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_13826_person_100206721_aut_Indian_Drawings_12_item77,
