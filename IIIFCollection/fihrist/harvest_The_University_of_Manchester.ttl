fihrist:manuscript_6843 a mdhn:Manuscript ;
    rdfs:label "Persian MS 347" ;
    dct:date "1820-07-04" ;
    dct:description """The first of two copies of the Tarjumah-'i Nād Purān (Translation of the Nād Purān ) held in the Rylands (see also Persian MS 348 ). 
                     This Persian translation of an unidentified Sanskrit or Brajbhasha work on music originally entitled Nāda-purāṇa (Ancient Text on Music), describes the musical scales and their qualities, replete with many illustrative diagrams, along with a final section on the different rasa (taste, essence, aesthetics) and bhava (expressions) in classical Indian music.""" ;
    dct:identifier "manuscript_6843" ;
    dct:language "fa" ;
    dct:spatial "Achanak (near Mansa), Punjab" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
