fihrist:manuscript_7023 a mdhn:Manuscript ;
    rdfs:label "Persian MS 528" ;
    dct:date """951 AH (1544–1545
                        CE)""" ;
    dct:description """A collection of epistles entitled Ruqʻāt-i Jāmī (Letters
                     of Jāmī) by Timurid-era Sufi poet by ‘Abd al-Raḥmān
                        Jāmī (d. 1492) . Copied in elegant ta‘līq script typically
                     employed for missives by a scribe named Darvīsh ‘Alī bin Pīr Aḥmad
