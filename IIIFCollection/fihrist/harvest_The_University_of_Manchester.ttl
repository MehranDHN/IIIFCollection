fihrist:manuscript_6691 a mdhn:Manuscript ;
    rdfs:label "Persian MS 21" ;
    dct:date """1043 to 1045 AH
                           (1633–35 CE)""" ;
    dct:description """This copy of the Mas̲navī-i Ma‘navī (Spiritual Couplets)
                     by Jalāl al-Dīn Rūmī (1207–1273) opens with a brief Arabic preface and contains
                     six lavishly illuminated carpet page openings that indicate the start of each
                     of book within the volume. A scribe named Bāyazīd completed this manuscript
                     between 1043 and 1044 AH (1633–35 CE) in Sar-i Hind (Frontier of
                     India), possibly the town of Sirhind-Fategarh, Punjab .""" ;
    dct:identifier "manuscript_6691" ;
    dct:language "fa" ;
    dct:spatial "Sirhind-Fategarh, Punjab" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
