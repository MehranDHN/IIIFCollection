fihrist:manuscript_6770 a mdhn:Manuscript ;
    rdfs:label "Persian MS 281" ;
    dct:description """The Dīvān of poet Ḥaydar Haravī (d.
                        1552) , popularly known as Kulūch (Biscuit) or Kulūchah-Paz on account of his
                     profession as a biscuit-baker and merchant. Originally from Herat, his trade
                     took him to India. Despite the poet's contemporary, Timurid vizier Mīr ‘Alī Shīr Navā'ī description of him in the Majālis al-Nafā'is (Assemblies of Elegancies) as illiterate
                     and of modest talent, an opinion repatedly cited by subsequent authors, his
                     works have only very recently received critical scholarly attention.""" ;
    dct:identifier "manuscript_6770" ;
    dct:language "fa" ;
    dct:spatial "Greater Iran>" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
