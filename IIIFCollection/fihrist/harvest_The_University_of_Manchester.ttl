fihrist:manuscript_6712 a mdhn:Manuscript ;
    rdfs:label "Persian MS 229" ;
    dct:date """17th century
                        CE""" ;
    dct:description """A complete manuscript of the Silsilah-'i Ẕahab (Golden
                     Chain), first of seven books from the Haft Awrang (Seven
                     Thrones) by the late Timurid-era poet ‘Abd al-Raḥmān
                        Jāmī (d. 1492) . While it lacks a signature and date, its
                     condition and 18th century provenance suggest it must be earlier, probably 17th
                     century, and possibly completed in either Greater
                        Iran or the Indian
                        subcontinent .""" ;
    dct:identifier "manuscript_6712" ;
    dct:language "fa" ;
    dct:spatial """Greater
                        Iran""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
    mdhn:hasContribution contrib:manuscript_6712_person_120696480_fmo,
