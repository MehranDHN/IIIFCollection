fihrist:manuscript_7412 a mdhn:Manuscript ;
    rdfs:label "Persian MS 900" ;
    dct:date "1683-02-05" ;
    dct:description """A complete copy of the Mirʼāt-i
                        Sikandarī (Alexander's Mirror) a history of the Muẓaffarid dynasty
                     that ruled Gujarat until annexed by the Mughals in 1573.
                     Finished about 70 years after Iskandar ibn Muḥammad Manjū (b. ca.
                        1582) first authored it between 1611 to 1613, the bibliophile
                     governor of Chittoor ‘Abd al-Vahhāb (d. ca. 1801) before
                     it was plundered by the ruler of Mysore Ḥaydar ‘Alī , then
                     again by British forces after they defeated his son and successor Tīpū Sulṭān (b. 1753, r. 1782–1799) .""" ;
    dct:identifier "manuscript_7412" ;
    dct:language "fa" ;
    dct:spatial """Indian
                        subcontinent""" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
