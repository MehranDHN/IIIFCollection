fihrist:manuscript_6779 a mdhn:Manuscript ;
    rdfs:label "Persian MS 29" ;
    dct:date """probably late 16th
                                century CE""" ;
    dct:description """A nearly complete, illuminated and illustrated Safavid-era copy of
                            the Subḥat al-Abrār (Rosary of the Pious), the third of
                            seven books in the collection entitled Haft Awrang (Seven
                            Thrones) by ‘Abd
                                al-Raḥmān Jāmī (d. 1492) . A scribe named Shāh Muḥammad
                                al-Kātib completed this volume, in the Safavid Empire , probably during the late 16th century
                            CE .""" ;
