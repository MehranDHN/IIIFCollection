fihrist:manuscript_7258 a mdhn:Manuscript ;
    rdfs:label "Persian MS 753" ;
    dct:date "1863" ;
    dct:description """What appears to be the sole surviving copy of the Su’ālāt-i
                                ‘Ashr (Ten Questions) on Islamic theological issues by Mīrzā Jān Munshī ,
                            followed by answers provided by Maulavī Shāh ‘Abd al-‘Azīz .
                            Compiled by Aḥmad
                                Khayrābādī in 1230 AH (1815 CE) . Fifty years later, an unidentified Dehli scribe completed this
                            manuscript as a gift for Colonel George William
                                Hamilton at the end of Muḥarram 1280 AH
                                (16 Jul 1863 CE) .""" ;
    dct:identifier "manuscript_7258" ;
    dct:language "fa" ;
    dct:spatial "Shāhjahānābād (Dehli)" ;
    dct:type "codex" ;
