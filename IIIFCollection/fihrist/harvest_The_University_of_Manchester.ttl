fihrist:manuscript_6996 a mdhn:Manuscript ;
    rdfs:label "Persian MS 50" ;
    dct:date "1807-01-10" ;
    dct:description """This complete copy of the Dīvān of Ḥāfiẓ (ca. 1315–1390)
                     contains most of the ghazal lyric poems and quatrains typically found in other
                     copies. It also features a lavishly illuminated opening folios, headers, and
                     margins. A scribe named Muḥammad ‘Alī Khvānsar completed this volume in Hyderabad at the start of Ẕī al-Qa‘dah 1221 AH (early–mid Jan.
                        1807) , for the British Resident at Hyderabad, Thomas Sydenham (1780–1816) .""" ;
    dct:identifier "manuscript_6996" ;
    dct:language "fa" ;
    dct:spatial "Hyderabad" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_The_University_of_Manchester_Library ;
