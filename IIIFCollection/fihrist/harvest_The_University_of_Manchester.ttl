fihrist:manuscript_7351 a mdhn:Manuscript ;
    rdfs:label "Persian MS 842" ;
    dct:date "1530" ;
    dct:description """Renowned Safavid-era calligrapher Sulṭān Muḥammad Khandān (fl. early 16th c.) completed this copy
                     of the Dīvān of Ḥāfiẓ (ca. 1315–1390) in Herat in 937 AH
                        (1530 CE) . This volume features most of the ghazal lyric poems set
                     within lavishly illuminated margins, although it omits quatrains typically
                     found in other copies.""" ;
