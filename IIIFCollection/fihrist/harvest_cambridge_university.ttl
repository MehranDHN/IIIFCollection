fihrist:manuscript_16739 a mdhn:Manuscript ;
    rdfs:label "Or. 1878" ;
    dct:date """19th
                        cent.""" ;
    dct:description """This manuscript is comprised of four works, the Testament of Abraham,
                     Testament of Isaac, Testament of Jacob (ገድለ ፡ አብርሃም, ገድለ ፡ ይስሐቅ, ገድለ ፡ ያዕቆብ), and a homily attributed to Ephrem on
                     Abraham and Sarah in Egypt (ድርሳነ ፡ ሳራ), which in the Ethiopian tradition is almost always
                     circulate together as a unit.""" ;
    dct:identifier "manuscript_16739" ;
    dct:language "gez" ;
    dct:spatial "Ethiopia" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
    mdhn:hasContribution contrib:manuscript_16739_person_172919290_cataloguer,
