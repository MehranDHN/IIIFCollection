fihrist:manuscript_11858 a mdhn:Manuscript ;
    rdfs:label "Or_1081.2.75" ;
    dct:description """Seventeen small paper fragments in Syriac script. These are
                                among other fragments with this classmark. The Syriac-script
                                fragments are nos. 2 3 6 12 13 16 19 20 21 23 24 26 27 28 30 31 35.
                                They are mostly Garshuni and mostly snatches of prayers, Psalms,
                                liturgical texts, and alphabets. No. 19 is the beginning of a memra on Palm Sunday in Syriac. No. 30 is described by G. Kiraz at http://www.lib.cam.ac.uk/collections/departments/taylor-schechter-genizah-research-unit/fragment-month/fotm-2018/fragment-6 .""" ;
    dct:identifier "manuscript_11858" ;
    dct:language "ar" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
    mdhn:heldAt glam:Cambridge_University_University_Library ;
    mdhn:heldBy glam:Cambridge_University ;
