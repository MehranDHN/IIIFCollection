fihrist:work_1557 a mdhn:Work ;
    rdfs:label "Ḥikāyat al-dīk wa-al-thaʻlab, qiṣṣat al-ʻuṣfūr maʻ al-ṣayyād [min ḥikāyat al-malik Jālʻād], ḥikāyat al-jarad wa-sannawr, ḥikāyat al-nāsik wa-al-summun, ḥikāyat al-samak wa-alghadīr, ḥikāyat al-ghurāb wa-al-ḥayyah, ḥikāyat al-thaʻlab wa-al-ḥimār, ḥikāyat al-malik maʻal-sāʼiḥ, ḥkāyat al-bāz wa-al-ghurāb, ḥikāyat al-ḥāwī wa-mirʼātihi, ḥikayat al-ʻankabūtah maʻ al-rīḥ, ḥikāyat al-aʻmá wa-al-maqʻad, ḥikāyat al-asad wa-al-ṣayyād, ḥikāyat al-rajul wa-al-samaka, ḥikāyat al-fatá wa-al-luṣūṣ, ḥikāyat al-bustānī wa-imraʼatihi, ḥikāyat al-tājir wa-al-luṣūṣ, ḥikāyat al-thaʻlab wa-al-dhiʼb wa-al-asad, ḥikāyat al-rāʻī wa-al-luṣūṣ, ḥikāyat al-daraj wa-al-zalāḥif" ;
    dct:identifier "work_1557" ;
    skos:altLabel """حكاية الديك والثعلب، قصة العنصور مع الصياد (من حكاية الملك
                        جلعاد)، حكاية جرد وسنور، حماية الناسك والسمن، حكاية السمك والغدير، حكاية
                        الغراب والحية، حكاية الثعلب والحمار، حكاية الملك مع السائح، حكاية الباز
                        والغراب، حكاية الحاوي ومراته، حكاية العنكبوتة مع الريح، حكاية الاعمى
                        والمعقد، حكاية الاسد والصياد، حكاية الرجل والسمكة، حكاية الفتى واللصوص،
                        حكاية البستاني وامراته، حكاية التاجر واللصوص، حكاية الثعلب والذئب والاسد،
                        حكاية الراعي واللصوص، حكاية الدرج والزلاحف""",
        """Ḥikāyat al-dīk wa-al-thaʻlab, qiṣṣat al-ʻuṣfūr maʻ
                        al-ṣayyād [min ḥikāyat al-malik Jālʻād], ḥikāyat al-jarad wa-sannawr,
                        ḥikāyat al-nāsik wa-al-summun, ḥikāyat al-samak wa-alghadīr, ḥikāyat
                        al-ghurāb wa-al-ḥayyah, ḥikāyat al-thaʻlab wa-al-ḥimār, ḥikāyat al-malik
                        maʻal-sāʼiḥ, ḥkāyat al-bāz wa-al-ghurāb, ḥikāyat al-ḥāwī wa-mirʼātihi,
                        ḥikayat al-ʻankabūtah maʻ al-rīḥ, ḥikāyat al-aʻmá wa-al-maqʻad, ḥikāyat
                        al-asad wa-al-ṣayyād, ḥikāyat al-rajul wa-al-samaka, ḥikāyat al-fatá
                        wa-al-luṣūṣ, ḥikāyat al-bustānī wa-imraʼatihi, ḥikāyat al-tājir wa-al-luṣūṣ,
                        ḥikāyat al-thaʻlab wa-al-dhiʼb wa-al-asad, ḥikāyat al-rāʻī wa-al-luṣūṣ,
                        ḥikāyat al-daraj wa-al-zalāḥif""" ;
    skos:prefLabel """Ḥikāyat al-dīk wa-al-thaʻlab, qiṣṣat al-ʻuṣfūr maʻ
                        al-ṣayyād [min ḥikāyat al-malik Jālʻād], ḥikāyat al-jarad wa-sannawr,
                        ḥikāyat al-nāsik wa-al-summun, ḥikāyat al-samak wa-alghadīr, ḥikāyat
                        al-ghurāb wa-al-ḥayyah, ḥikāyat al-thaʻlab wa-al-ḥimār, ḥikāyat al-malik
                        maʻal-sāʼiḥ, ḥkāyat al-bāz wa-al-ghurāb, ḥikāyat al-ḥāwī wa-mirʼātihi,
                        ḥikayat al-ʻankabūtah maʻ al-rīḥ, ḥikāyat al-aʻmá wa-al-maqʻad, ḥikāyat
                        al-asad wa-al-ṣayyād, ḥikāyat al-rajul wa-al-samaka, ḥikāyat al-fatá
                        wa-al-luṣūṣ, ḥikāyat al-bustānī wa-imraʼatihi, ḥikāyat al-tājir wa-al-luṣūṣ,
                        ḥikāyat al-thaʻlab wa-al-dhiʼb wa-al-asad, ḥikāyat al-rāʻī wa-al-luṣūṣ,
                        ḥikāyat al-daraj wa-al-zalāḥif""" ;
    mdhn:xmlId "work_1557" .

