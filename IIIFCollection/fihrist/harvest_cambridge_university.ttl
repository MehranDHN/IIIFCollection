fihrist:manuscript_11848 a mdhn:Manuscript ;
    rdfs:label "Add. 1165" ;
    dct:date """16th
                                cent.""" ;
    dct:description """The codex contains the four Gospels, Matthew , Mark , Luke , and John . The codex
                            begins with, a) ff. 3r-5r Prefatory
                            matter to the Gospels, and b) f. 5v An
                            Introduction Concerning the Concordance of the Four Gospels, f. 5v The Epistle of Eusebius to Carpianus, f. 6r a paragraph about the four
                            evangelists, especially Matthew, f. 6r titles of the chapters in Matthew, and f. 6v-8v Eusebian canons. Folios 1r-2v are blank.""" ;
    dct:identifier "manuscript_11848" ;
    dct:language "gez" ;
    dct:spatial "Ethiopia." ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
