fihrist:manuscript_11854 a mdhn:Manuscript ;
    rdfs:label "Add. 3682" ;
    dct:date """18th
                                cent.""" ;
    dct:description """This work is a typical example of a privately-owned Ethiopian
                            service-book containing hymns and prayers arranged for the hours.
                            Several coloured images are found towards the beginning and end of the
                            codex, with miscellaneous common service texts and other readings in
                            between. Images appear on f. 4r (Daniel
                            in the lion's den, St. George and the dragon, Virgin and child with
                            angels and a priest, and Täklä Haymanot and the dragon) and f. 95v (the Crucifixion).""" ;
    dct:identifier "manuscript_11854" ;
    dct:language "gez" ;
    dct:spatial "Ethiopia." ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
