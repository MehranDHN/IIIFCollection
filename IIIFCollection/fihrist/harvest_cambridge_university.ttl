fihrist:manuscript_9449 a mdhn:Manuscript ;
    rdfs:label "Gg.5.29" ;
    dct:date "Before second half of the sixth century A.H / twelfth century C.E." ;
    dct:description "This manuscript bearing the title al-Mughnī fī al-Ṭibābah contains a medical work written by the physician Hibat Allāh ibn al-Ḥusayn (d. 1101) commonly entitled al-Mughnī fī tadbīr al-amrāḍ wa-maʿrifat al-ʿilal wa-al-aʿrāḍ. The treatise, which was dedicated to the caliph al-Muqtadī (d. 1094) , classifies a number of diseases according to the part of the body they affected, describing their causes, symptoms and treatments in an original three column display . The date in the colophon of the manuscript is obliterated, but several ownership statements provide a terminus ante quem in the second half of the sixth century A.H / twelfth century C.E." ;
    dct:identifier "manuscript_9449" ;
    dct:language "ar" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
    mdhn:hasContribution contrib:manuscript_9449_person_306337405_aut_Gg5_29_item1,
        contrib:manuscript_9449_person_7443076_fmo,
        contrib:manuscript_9449_person_7443076_scr_Gg5_29_item1 ;
    mdhn:hasItem item:manuscript_9449_Gg5_29_item1 ;
    mdhn:hasSubject fihrist:subject_sh85083116 ;
    mdhn:heldAt glam:Cambridge_University_University_Library ;
    mdhn:heldBy glam:Cambridge_University ;
    mdhn:inCollection "Oriental Manuscripts" ;
    mdhn:material "chart" ;
    mdhn:shelfmark "Gg.5.29" ;
    mdhn:teiPath "C:\\Users\\Mehran\\Fihrist-As-RDF\\data\\fihrist-mss\\collections\\cambridge university\\Gg_5_29.xml" ;
    mdhn:xmlId "manuscript_9449" .

