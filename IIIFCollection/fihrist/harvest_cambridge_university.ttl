fihrist:manuscript_9504 a mdhn:Manuscript ;
    rdfs:label "Nn. 3.75" ;
    dct:date "before 1619" ;
    dct:description """Illuminated Qurʾān from the library of Tippoo Ṣāḥib, presented to the
                     University of Cambridge by the Court of Directors of the East India Company in
                     1806. The volume has two decorated shamsahs and two magnificent headpieces
                     containing the Fātiḥa. The text of the Qurʾān is followed by some prayers, and
                     a Fal-nāmah. The manuscript is not dated, but dates of ownership of 1028
                     A.H./1618 A.D and 1066 A.H./1655 A.D. occur at the beginning""" ;
    dct:identifier "manuscript_9504" ;
    dct:language "ar" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
    mdhn:hasContribution contrib:manuscript_9504_person_239176400_fmo,
