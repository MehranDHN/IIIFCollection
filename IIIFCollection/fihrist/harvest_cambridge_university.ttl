fihrist:manuscript_16740 a mdhn:Manuscript ;
    rdfs:label "Or. 2122" ;
    dct:date """19th
                        cent.""" ;
    dct:description """This Fetha
                        Nagast (fətḥa nägäśt, "Law of the Kings") was copied for mamher
                     (teacher) Germā Giyorgis and his father Ṣegē Mikā’ēl (ff. 144v, 147r) and was among the
                     trove that fell into the hands of the British at Magdala in 1868 . The phrase ‘pillar of faith Tēwodros ’ appears on 147r along with the names Habta
                           Giyorgis and Eḫeta Giyorgis .""" ;
    dct:identifier "manuscript_16740" ;
    dct:language "gez" ;
    dct:spatial "Ethiopia." ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
    mdhn:hasContribution contrib:manuscript_16740_person_280993109_oth,
        contrib:manuscript_16740_person_309637879_cataloguer,
