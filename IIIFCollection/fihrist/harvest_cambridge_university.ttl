fihrist:manuscript_11846 a mdhn:Manuscript ;
    rdfs:label "Oo. 1.41" ;
    dct:date """18th
                                cent.""" ;
    dct:description """The Gospel of John. The name of the scribe
                            ሲሎንዲስ occurs on ff. 129v and 131r . A prayer for the scribe is
                            included at the end of the manuscript on f. 129r. On f. 129v another
                            scribe Akliä Giyorgis, added the benediction, "Simeon, by name Papas but
                            not in practice.\"""" ;
    dct:identifier "manuscript_11846" ;
    dct:language "gez" ;
    dct:spatial "Ethiopia." ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Cambridge_University_Library ;
