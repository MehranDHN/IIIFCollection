fihrist:manuscript_1030 a mdhn:Manuscript ;
    rdfs:label "MS. Huntington donat. 18" ;
    dct:description """The volume contains 130 leaves. It is a collection of miscellaneous
                     pieces in Persian and Arabic in an unusual format. Through the greater part of
                     the volume, four (and sometimes five) different texts run side by side on the
                     same page. The centre of each page usually has two columns of writing; some
                     treatises will be written in the right column of the front-side of a leaf and
                     continued in the left-hand column of the back-side, while others will occupy
                     the left column of the front-side of a leaf and the right-hand column of the
                     back-side; the item catalogued here falls in the latter category. For a list of
                     the other items, see the Concordance of Manuscripts (Appendix I)in Emilie
                     Savage-Smith; A New Catalogue of Arabic Manuscripts in The Bodleian Library,
                     University of Oxford. Volume I: Medicine, Oxford: OUP, 2011, and SEB I, cols.
                     1093−6 no. 1904, for further details.""" ;
    dct:identifier "manuscript_1030" ;
    dct:language "ar" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Bodleian_Library ;
    mdhn:hasContribution contrib:manuscript_1030_person_103373918_trl_MS_Huntington_donat_18_item5,
        contrib:manuscript_1030_person_122088668_aut_MS_Huntington_donat_18_item2,
        contrib:manuscript_1030_person_287984736_aut_MS_Huntington_donat_18_item5,
        contrib:manuscript_1030_person_34684157_fmo,
        contrib:manuscript_1030_person_34684157_oth,
        contrib:manuscript_1030_person_68980610_aut_MS_Huntington_donat_18_item6,
