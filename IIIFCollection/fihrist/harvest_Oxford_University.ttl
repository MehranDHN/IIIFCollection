fihrist:manuscript_33217 a mdhn:Manuscript ;
    rdfs:label "MS. Pers. c. 37" ;
    dct:date "1085-07" ;
    dct:description """A copy of Abū Bakr (Abū Ḥakīm) Rabīʻ ibn Aḥmad al-Akhavayn al-Bukhārī's
                     early medical encyclopaedia in Persian, Hidayat al-mutaʻallimīn fī al-ṭibb.
                     Akhavayn or Akhavaynī was a pupil of Muḥammad ibn Zakarīyyā al-Rāzī and wrote
                     this work in 183 chapters. This copy, dated 478/1085, is the oldest dated Persian manuscript in
                     the Bodleian Libraries and there is only one other copy extant - Istanbul
                     Fatih, 3646.""" ;
    dct:identifier "manuscript_33217" ;
    dct:language "fa" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Bodleian_Library ;
    mdhn:hasContribution contrib:manuscript_33217_person_165823505_aut_MS_Pers_c_37_item1 ;
