        contrib:manuscript_23168_person_f6734_fmo,
        contrib:manuscript_23168_person_f8347_scr ;
    mdhn:hasItem item:manuscript_23168_MS_Laud_Or_283_item1 ;
    mdhn:hasSubject fihrist:subject_sh85022323 ;
    mdhn:heldAt glam:Oxford_University_Bodleian_Library ;
    mdhn:heldBy glam:Oxford_University ;
    mdhn:inCollection "Oriental Manuscripts" ;
    mdhn:material "chart" ;
