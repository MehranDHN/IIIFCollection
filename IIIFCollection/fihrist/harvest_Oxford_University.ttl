fihrist:manuscript_1746 a mdhn:Manuscript ;
    rdfs:label "MS. Selden superius 44" ;
    dct:date "1407",
        "1487",
        """15th
                           cent?""" ;
    dct:description """The volume contains 65 leaves. Folio 54a is blank. Folio 22 has been cut
                     out from the volume and is now missing except for a 30 mm strip still attached
                     in the gutter. Folio 23 is blank. Folios 24a–25b are bound in upside down in
                     the volume. Folio 26 is blank except for two lines of casually written poetry;
                     folio 27a is blank. Folio 57a is a later fihrist to the fragment comprising
                     item 6; folio 56b is blank. The two front and two back endleaves are blank,
                     except for the UAM entry number.""" ;
