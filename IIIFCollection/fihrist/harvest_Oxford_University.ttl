fihrist:manuscript_23118 a mdhn:Manuscript ;
    rdfs:label "MS. Caps. Or. A. 7" ;
    dct:date "1138",
        "1601-12",
        "1609-10-09",
        "1725/6" ;
    dct:description """Two separate parts of Ḫvāce Mollā Saʻdeddīn Muḥammed Efendi bin
                            Ḥasancān's history of the Ottoman dynasty from its origin to the reign
                            of Sulṭān Selīm I, compiled during the reign of Selīm II and dedicated
                            to Murād III. The first ( ff. 1b-369b )
                            ends with the account of Meḥmed/Muḥammed II and leaves out the section
                            on the lives of famous scholars. It is given the lengthy descriptive
                            title ابتداءِ ظهور ال عثوان ابقاهم الله الی اخرا الدوران لسنه سته
                                وثمانین وسته مائه وابتداءِ فتح قلعه فوالجه وحصار اینه کول
                                لسنه سبع وثمانین وسته مائه حرر فی اواخر سنه اثنین وتسعین والف اکان
                                ابقاهم الله تعالی الی اخرا الزمان اربعه ماٸه وسته سنه الی هنا ایدهم
                                الله تعالی وسصرهم الی الانقراضِ الازمان on f. 1a . The second ( ff.
                                ff. 370b-521b ) begins with the reign of Bāyezīd II but stops
                            with the ascension to the throne of Selīm II, yet does include scholarly
                            biographies. It is titled simply قتعة من تاریخ خواجه on f. 370a .""" ;
    dct:identifier "manuscript_23118" ;
    dct:language "ota" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Bodleian_Library ;
    mdhn:hasContribution contrib:manuscript_23118_person_13740033_aut_MS_Caps_Or_A_7_item1,
        contrib:manuscript_23118_person_76658435_fmo,
        contrib:manuscript_23118_person_f7921_scr ;
    mdhn:hasItem item:manuscript_23118_MS_Caps_Or_A_7_item1 ;
    mdhn:hasSubject fihrist:subject_sh85138802 ;
    mdhn:heldAt glam:Oxford_University_Bodleian_Library ;
    mdhn:heldBy glam:Oxford_University ;
    mdhn:inCollection "Oriental Manuscripts" ;
    mdhn:material "chart" ;
