fihrist:manuscript_11162 a mdhn:Manuscript ;
    rdfs:label "MS. Huntington 370" ;
    dct:description """The volume consists of 244 folios. Folio 225a has a recipe to stop
                     nosebleed. Folio 244a has a khawāṣṣ recipe and an owner’s note (different hand)
