fihrist:manuscript_23119 a mdhn:Manuscript ;
    rdfs:label "MS. Rawlinson Or. 32" ;
    dct:description """Partial copy of Ḫvāce Mollā Saʻdeddīn Muḥammed Efendi bin
                            Ḥasancān's history of the Ottoman dynasty from its origin to the reign
                            of Sulṭān Selīm I, compiled during the reign of Selīm II and dedicated
                            to Murād III. Ends with the account of Meḥmed/Muḥammed II and leaves
                            out the section on the reign of Selīm II and the lives of famous
                            scholars. Folio is split into two halves, which are out of order; the
                            first on ff. 164-337 and the last on ff. 1-161 .""" ;
    dct:identifier "manuscript_23119" ;
    dct:language "ota" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Bodleian_Library ;
