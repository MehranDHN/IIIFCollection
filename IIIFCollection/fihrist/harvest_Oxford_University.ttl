item:manuscript_1032_MS_Huntington_donat_8_item3 a mdhn:ManuscriptItem ;
    rdfs:label """Prayers taken from passages of the Qurʼān and collected
                        by one "Muḥammad ibn al-Wafā" (author of UAM. 1222 (1)), whom Brock,
                        identifies both with Jamāl al-Dīn Muḥammad ibn al-Wafā al-Sūlī [I. 274 (S1,
