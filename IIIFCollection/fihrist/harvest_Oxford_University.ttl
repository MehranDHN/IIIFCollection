fihrist:manuscript_23115 a mdhn:Manuscript ;
    rdfs:label "MS. Caps. Or. C. 11" ;
    dct:date "1574",
        "987" ;
    dct:description """Copy of a history of the Ottoman Sulṭāns from the rise to power of
                            ʻOs̱mān I to the ascension of Murād III. Ethé notes that this extends
                            twenty years beyond all other known copies of this work. Since the
                            author is supposed to have died before completing it, this suggests
                            either that the author lived longer than previously thought, or that
                            this part of the text was added on by a later anonymous
                            author.""" ;
    dct:identifier "manuscript_23115" ;
    dct:language "ota" ;
    dct:type "codex" ;
    mdhn:digitallyPublishedBy glam:publisher_Bodleian_Library ;
    mdhn:hasContribution contrib:manuscript_23115_person_f7944_aut_MS_Caps_Or_C_11_item1 ;
