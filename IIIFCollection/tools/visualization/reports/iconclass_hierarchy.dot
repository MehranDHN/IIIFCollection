  "iconclass12I61" [label="temple, shrine ~ Islam, Mohammedanism (iconclass12I61)", tooltip="Official Iconclass notation 12I61:      temple, shrine ~ Islam, Mohammedanism.     Official class for mosque, masjid, shrine and ziyārat as      depicted architecture (keywords in Iconclass include mosque, minaret).     Pair with 48C1623 when a dome is the visual focus.", fillcolor="#cfe2f3"];
  "iconclass22C312" [label="mandorla (iconclass22C312)", tooltip="Official Iconclass notation 22C312: mandorla.     Whole-body almond-shaped radiance; contrast with head-nimbus 22C311.", fillcolor="#cfe2f3"];
  "iconclass22C31" [label="radiance emanating from persons or things (iconclass22C31)", tooltip="Official Iconclass notation 22C31: radiance emanating from persons or things.", fillcolor="#cfe2f3"];
