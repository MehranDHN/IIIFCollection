  "iconclass41D21" [label="clothes covering the entire body (iconclass41D21)", tooltip="Official Iconclass notation 41D21: clothes covering the entire body.", fillcolor="#cfe2f3"];
  "iconclass41D24" [label="clothes for special purposes (iconclass41D24)", tooltip="Official Iconclass notation 41D24: clothes for special purposes.", fillcolor="#cfe2f3"];
  "iconclass41D23" [label="clothing for the lower part of the body (iconclass41D23)", tooltip="Official Iconclass notation 41D23: clothing for the lower part of the body.", fillcolor="#cfe2f3"];
  "iconclass41D28" [label="disguise (iconclass41D28)", tooltip="Official Iconclass notation 41D28: disguise.", fillcolor="#cfe2f3"];
  "iconclass41D27" [label="drapery, draped garment (iconclass41D27)", tooltip="Official Iconclass notation 41D27:      drapery, draped garment, 'Gewandgebung'.", fillcolor="#cfe2f3"];
  "iconclass41D22" [label="head-gear and clothing for the upper part of the body (iconclass41D22)", tooltip="Official Iconclass notation 41D22: head-gear and clothing for the upper part of the body.", fillcolor="#cfe2f3"];
  "iconclass41D25" [label="underclothes and nightwear (iconclass41D25)", tooltip="Official Iconclass notation 41D25: underclothes and nightwear.", fillcolor="#cfe2f3"];
  "iconclass71A63" [label="Adam and Eve doing penance (iconclass71A63)", tooltip="Official Iconclass notation 71A63: Adam and Eve doing penance.", fillcolor="#cfe2f3"];
  "iconclass71A62" [label="Adam and Eve outside Eden (iconclass71A62)", tooltip="Official Iconclass notation 71A62:      Adam and Eve outside Eden, whose entrance is guarded by shining cherubim.", fillcolor="#cfe2f3"];
  "iconclass71A61" [label="God expels Adam and Eve from paradise (iconclass71A61)", tooltip="Official Iconclass notation 71A61:      God expels Adam and Eve from paradise and has the tree of life      guarded by an angel with a flaming sword.", fillcolor="#cfe2f3"];
  "iconclass25FF4" [label="fabulous animals ~ reptiles (iconclass25FF4)", tooltip="Official Iconclass notation 25FF4: fabulous animals ~ reptiles.", fillcolor="#cfe2f3"];
  "iconclass25FF411" [label="dragon (iconclass25FF411)", tooltip="Official Iconclass notation 25FF411: dragon.     Use this for the four-legged / lizard-like dragon.     For the large fabulous serpent (sometimes winged), also use 25FF422.", fillcolor="#cfe2f3"];
  "iconclass25FF41" [label="fabulous animals ~ lizards (iconclass25FF41)", tooltip="Official Iconclass notation 25FF41: fabulous animals ~ lizards.", fillcolor="#cfe2f3"];
  "iconclass25FF412" [label="salamander (fabulous animal); salamander as spirit of fire (iconclass25FF412)", tooltip="Official Iconclass notation 25FF412: salamander (fabulous animal); salamander as spirit of fire.", fillcolor="#cfe2f3"];
  "iconclass25FF42" [label="fabulous animals ~ snakes (iconclass25FF42)", tooltip="Official Iconclass notation 25FF42:      fabulous animals ~ snakes (aspic, dragon, hydrus, hydra,      amphisbaena, horned snake, cerastes).", fillcolor="#cfe2f3"];
  "iconclass25FF424" [label="amphisbaena (snake with head at both ends) (iconclass25FF424)", tooltip="amphisbaena (snake with head at both ends)", fillcolor="#cfe2f3"];
  "iconclass25FF421" [label="aspic (iconclass25FF421)", tooltip="aspic", fillcolor="#cfe2f3"];
  "iconclass25FF422" [label="dragon (large fabulous serpent, sometimes with wings and legs) (iconclass25FF422)", tooltip="Official Iconclass notation 25FF422:      dragon (large fabulous serpent, sometimes with wings and legs).     Preferred official term for azhdahā / tannīn-type dragons      in Persian and Islamic manuscript painting.     Contrast with 25FF411 (lizard-like dragon).", fillcolor="#cfe2f3"];
  "iconclass25FF425" [label="horned snake (iconclass25FF425)", tooltip="horned snake", fillcolor="#cfe2f3"];
  "iconclass25FF423" [label="hydrus (watersnake) (iconclass25FF423)", tooltip="hydrus (watersnake)", fillcolor="#cfe2f3"];
  "iconclass41D" [label="fashion, clothing (iconclass41D)", tooltip="Official Iconclass notation 41D: fashion, clothing.", fillcolor="#cfe2f3"];
  "iconclass45K13" [label="fortress (iconclass45K13)", tooltip="Official Iconclass notation 45K13: fortress.     Use for qalʿa / dezh as a depicted military stronghold.     Pair with 48C16 architectural detail when walls, towers or      a dome on a citadel are the pictorial focus.", fillcolor="#cfe2f3"];
