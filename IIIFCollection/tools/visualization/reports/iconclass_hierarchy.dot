digraph iconclass_hierarchy_rq {
  rankdir=TB;
  graph [bgcolor="#ffffff"];
  node [shape=box, style="filled,rounded", fontname="Arial", fontsize=9, penwidth=0.8];
  edge [color="#555555", arrowsize=0.8];
  overlap=scale;
  splines=true;
  ranksep=1.0;
  nodesep=0.4;
  "iconclass71" [label="Old Testament (iconclass71)", tooltip="Old Testament", fillcolor="#cfe2f3"];
  "iconclass7" [label="mdhn:iconclass7", tooltip="mdhn:iconclass7", fillcolor="#f2f2f2"];
  "iconclass45C1" [label="weapons (iconclass45C1)", tooltip="Official Iconclass notation 45C1: weapons.", fillcolor="#cfe2f3"];
  "iconclass45C" [label="(military) equipment and supply (iconclass45C)", tooltip="Official Iconclass notation 45C: (military) equipment and supply.", fillcolor="#cfe2f3"];
  "iconclass71A331" [label="Adam alone in the Garden of Eden (iconclass71A331)", tooltip="Official Iconclass notation 71A331: Adam alone in the Garden of Eden.", fillcolor="#cfe2f3"];
  "iconclass71A33" [label="Adam in the Garden of Eden (iconclass71A33)", tooltip="Official Iconclass notation 71A33:      Adam in the Garden of Eden.", fillcolor="#cfe2f3"];
  "iconclass71A332" [label="Adam naming the animals (iconclass71A332)", tooltip="Official Iconclass notation 71A332: Adam naming the animals.", fillcolor="#cfe2f3"];
  "iconclass71A333" [label="Adam receiving the commandment not to eat from the tree of knowledge (iconclass71A333)", tooltip="Official Iconclass notation 71A333:      Adam receiving the commandment not to eat from the tree of knowledge.", fillcolor="#cfe2f3"];
  "iconclass_DhulQarnayn" [label="Dhul-Qarnayn (the Two-Horned One) (iconclass_DhulQarnayn)", tooltip="Project-specific extension for the Quranic figure Dhul-Qarnayn.     In Islamic tradition widely identified with Alexander / Iskandar.     Covers the prophetic and righteous-ruler aspects (building the wall against Gog and Magog,      seeking the Water of Life, etc.) that are not fully captured by the classical Iconclass notation.", fillcolor="#cfe2f3"];
  "iconclass98B_Alexander" [label="Alexander the Great (iconclass98B_Alexander)", tooltip="Official Iconclass notation for the historical and classical legendary figure of Alexander the Great.", fillcolor="#cfe2f3"];
  "iconclass_Birth_of_Muhammad" [label="Birth of the Prophet Muhammad (iconclass_Birth_of_Muhammad)", tooltip="Project-specific extension for the birth of the Prophet Muhammad.      The mother reclines on a couch while the newborn is handed to one of two attending angels.      The composition is known from Ilkhanid manuscript painting (notably the Edinburgh      Jāmiʿ al-Tawārīkh) and later prophetic cycles.      No exact official Iconclass notation exists for this Islamic prophetic subject;      the term is therefore marked as limited-scope.", fillcolor="#cfe2f3"];
  "iconclass_ArabianProphets" [label="Arabian Prophets (iconclass_ArabianProphets)", tooltip="Arabian Prophets", fillcolor="#cfe2f3"];
  "iconclass71E1164" [label="Moses and Aaron before Pharaoh; Aaron’s rod changes into a snake (iconclass71E1164)", tooltip="Official Iconclass notation 71E1164:      Moses and Aaron before Pharaoh; Aaron performs the miracle of the rod changing into a snake.", fillcolor="#cfe2f3"];
  "iconclass71E116" [label="Moses and Aaron confront Pharaoh (iconclass71E116)", tooltip="Official Iconclass notation 71E116:      Moses and Aaron confront Pharaoh (Exodus 5–7:13).      Parent term for the miracle of the rod changing into a snake and related scenes.", fillcolor="#cfe2f3"];
  "iconclass_Salih_SheCamel" [label="Ṣāliḥ leading the she-camel from the mountain (iconclass_Salih_SheCamel)", tooltip="Project-specific extension for the miracle of the prophet Ṣāliḥ      bringing forth (or leading) the she-camel of God (nāqat Allāh) from the side of a      mountain or rock.      This is a purely Islamic prophetic subject with no corresponding official Iconclass      notation. The visual formula is well-attested in Jāmiʿ al-Tawārīkh and Qiṣaṣ al-Anbiyāʾ      manuscripts.", fillcolor="#cfe2f3"];
  "iconclass_PropheticBirths" [label="Births of Prophets (iconclass_PropheticBirths)", tooltip="Births of Prophets", fillcolor="#cfe2f3"];
  "iconclass11G" [label="angels (iconclass11G)", tooltip="Official Iconclass notation 11G: angels.     Official visual class for winged celestial messengers.     Use also for malāʾika in Persian/Islamic painting      (birth of the Prophet, Revelation scenes, etc.).", fillcolor="#cfe2f3"];
  "iconclass11" [label="Christian religion (iconclass11)", tooltip="Official Iconclass notation 11: Christian religion.     Parent of angels (11G), saints (11H), and prophets not in biblical context (11I).     Use as broader only; pictorial scenes of angels in Islamic manuscripts      still take 11G as the visual class.", fillcolor="#cfe2f3"];
  "iconclass11H" [label="male saints (iconclass11H)", tooltip="Iconclass division 11H: male saints (including named individual saints such as Saint George, the Seven Sleepers, etc.).", fillcolor="#cfe2f3"];
  "iconclass98" [label="Classical Mythology and Ancient History (iconclass98)", tooltip="Official Iconclass notation 98: Classical Mythology and Ancient History (male classical heroes).", fillcolor="#cfe2f3"];
  "iconclass9" [label="Classical Mythology and Ancient History (iconclass9)", tooltip="Classical Mythology and Ancient History", fillcolor="#cfe2f3"];
  "iconclass98B" [label="male persons from classical history (iconclass98B)", tooltip="male persons from classical history", fillcolor="#cfe2f3"];
  "iconclass_GogMagogWall" [label="Wall against Gog and Magog (iconclass_GogMagogWall)", tooltip="Project-specific extension for the motif of the iron wall (or rampart)      built by Dhul-Qarnayn / Iskandar against the tribes of Gog and Magog (Yaʾjūj wa Maʾjūj).     This is one of the most distinctive visual and narrative elements of the Islamic Alexander /      Dhul-Qarnayn tradition and appears in Persian manuscript painting of the Iskandarnama cycle.", fillcolor="#cfe2f3"];
  "iconclass71E1" [label="the book Exodus: story of Moses and Aaron (iconclass71E1)", tooltip="the book Exodus: story of Moses and Aaron", fillcolor="#cfe2f3"];
  "iconclass71E" [label="Exodus, Leviticus, Numbers, Deuteronomy, Joshua (iconclass71E)", tooltip="Official Iconclass notation 71E:      Exodus, Leviticus, Numbers, Deuteronomy, Joshua:      from the bondage of the Israelites in Egypt to their settlement in Canaan.", fillcolor="#cfe2f3"];
  "iconclass71A_PersianParadise" [label="Adam and Eve in the Persian pictorial tradition of Paradise (iconclass71A_PersianParadise)", tooltip="Adam and Eve in the Persian pictorial tradition of Paradise", fillcolor="#cfe2f3"];
  "iconclass71A" [label="Genesis from the creation to the expulsion from paradise, and later years of Adam and Eve (iconclass71A)", tooltip="Genesis from the creation to the expulsion from paradise, and later years of Adam and Eve", fillcolor="#cfe2f3"];
  "iconclass71A4" [label="Temptation and Fall (iconclass71A4)", tooltip="Official Iconclass notation 71A4:      Temptation and Fall (Genesis 3:1-7).", fillcolor="#cfe2f3"];
  "iconclass71A5" [label="Temptation and Fall: Adam and Eve in paradise (after the Fall) (iconclass71A5)", tooltip="Official Iconclass notation 71A5:      Temptation and Fall: Adam and Eve in paradise (after the Fall) (Genesis 3:8-21).", fillcolor="#cfe2f3"];
  "iconclass71A3" [label="creation of man; the Garden of Eden (iconclass71A3)", tooltip="Official Iconclass notation 71A3:      creation of man; the Garden of Eden (Genesis 1:26 – 2).", fillcolor="#cfe2f3"];
  "iconclass71A6" [label="expulsion of Adam and Eve from paradise (iconclass71A6)", tooltip="Official Iconclass notation 71A6:      expulsion of Adam and Eve from paradise (Genesis 3:22-24).", fillcolor="#cfe2f3"];
  "iconclass71A8" [label="the story of Cain and Abel (Genesis 4:3-17) (iconclass71A8)", tooltip="Iconclass 71A8 – the story of Cain and Abel (Genesis 4:3-17)", fillcolor="#cfe2f3"];
  "iconclass71B3" [label="story of Noah (iconclass71B3)", tooltip="story of Noah", fillcolor="#cfe2f3"];
  "iconclass71B" [label="Genesis from the descendants of Cain and Seth to Abraham (iconclass71B)", tooltip="Official Iconclass notation 71B: Genesis from the descendants of Cain and Seth to Abraham.", fillcolor="#cfe2f3"];
  "iconclass71C1" [label="story of Abraham (iconclass71C1)", tooltip="story of Abraham", fillcolor="#cfe2f3"];
  "iconclass71C" [label="Genesis: the patriarchs (iconclass71C)", tooltip="Official Iconclass notation 71C: Genesis: the patriarchs.", fillcolor="#cfe2f3"];
  "iconclass71D_PersianCycle" [label="Yusuf cycle in Persian manuscript tradition (iconclass71D_PersianCycle)", tooltip="Convenience node that groups the most relevant 71D children for Persian cultural heritage resources.", fillcolor="#cfe2f3"];
  "iconclass71D" [label="Genesis: the story of Joseph (iconclass71D)", tooltip="Iconclass 71D – full story of Joseph (son of Jacob). Central shared Biblical–Quranic narrative; highly relevant for Persian Yusuf va Zulaykha cycles.", fillcolor="#cfe2f3"];
  "iconclass71D1" [label="story of Joseph (part I) (iconclass71D1)", tooltip="story of Joseph (part I)", fillcolor="#cfe2f3"];
  "iconclass71D2" [label="story of Joseph (part II) (iconclass71D2)", tooltip="story of Joseph (part II)", fillcolor="#cfe2f3"];
  "iconclass71A311" [label="the man (Adam) comes to life (iconclass71A311)", tooltip="Official Iconclass notation 71A311:      the man (Adam) comes to life; usually God stretches out his hand      or breathes life into his nostrils.", fillcolor="#cfe2f3"];
  "iconclass71A31" [label="God fashions man from clay (iconclass71A31)", tooltip="Official Iconclass notation 71A31:      God forms / fashions man from clay (or dust).", fillcolor="#cfe2f3"];
  "iconclass71A321" [label="creation of Eve (iconclass71A321)", tooltip="Official Iconclass notation 71A321:      creation of Eve (from Adam’s rib).", fillcolor="#cfe2f3"];
  "iconclass71A32" [label="God planting the Garden of Eden (iconclass71A32)", tooltip="Official Iconclass notation 71A32:      God planting the Garden of Eden.", fillcolor="#cfe2f3"];
  "iconclass71A32122" [label="Eve is presented to Adam (iconclass71A32122)", tooltip="Official Iconclass notation 71A32122:      Eve is presented to Adam (after her creation).", fillcolor="#cfe2f3"];
  "iconclass71A3212" [label="God takes a rib from Adam’s side while he is sleeping (iconclass71A3212)", tooltip="Official Iconclass notation 71A3212:      God takes a rib from Adam’s side while he is sleeping.", fillcolor="#cfe2f3"];
  "iconclass71A32121" [label="God forms Eve from Adam’s rib (iconclass71A32121)", tooltip="Official Iconclass notation 71A32121:      God forms Eve from the rib taken from Adam.", fillcolor="#cfe2f3"];
  "iconclass12I6" [label="places and objects of worship ~ Islam, Mohammedanism (iconclass12I6)", tooltip="Official Iconclass notation 12I6: places and objects of worship ~ Islam, Mohammedanism.", fillcolor="#cfe2f3"];
  "iconclass12I" [label="Islam, Mohammedanism (iconclass12I)", tooltip="Official Iconclass notation 12I: Islam, Mohammedanism.     Official parent for Islamic places of worship, ritual, and functionaries.     The historical correlate 'Mohammedanism' is retained only as the Iconclass label.", fillcolor="#cfe2f3"];
  "iconclass71D13_ZulaykhaWomen" [label="Zulaykha invites the Egyptian women; they cut their hands at the sight of Yusuf (iconclass71D13_ZulaykhaWomen)", tooltip="Project-specific refinement of 71D13. Central visual motif in Persian Yusuf va Zulaykha manuscripts.", fillcolor="#cfe2f3"];
  "iconclass71D13" [label="Joseph in Potiphar's house; the chastity of Joseph (Genesis 39) (iconclass71D13)", tooltip="Extremely important for Persian tradition – the core of the Zulaykha narrative.", fillcolor="#cfe2f3"];
  "iconclass71E11641" [label="Aaron’s rod swallows the magicians’ snakes (iconclass71E11641)", tooltip="Official Iconclass notation 71E11641:      All the magicians summoned by the king turn their rods into snakes,      but Aaron’s rod swallows them.", fillcolor="#cfe2f3"];
  "iconclass25" [label="earth, world as celestial body (iconclass25)", tooltip="Official Iconclass notation 25: earth, world as celestial body.", fillcolor="#cfe2f3"];
  "iconclass2" [label="Nature (iconclass2)", tooltip="Nature", fillcolor="#cfe2f3"];
  "iconclass22" [label="natural phenomena (iconclass22)", tooltip="Official Iconclass notation 22: natural phenomena.", fillcolor="#cfe2f3"];
  "iconclass71I" [label="story of Solomon (iconclass71I)", tooltip="story of Solomon", fillcolor="#cfe2f3"];
  "iconclass71V" [label="the book of Jonah (iconclass71V)", tooltip="Official Iconclass notation 71V: the book of Jonah.", fillcolor="#cfe2f3"];
  "iconclass1" [label="Religion and Magic (iconclass1)", tooltip="Religion and Magic", fillcolor="#cfe2f3"];
  "iconclass12" [label="non-Christian religions (including institutions, customs and antiquities) (iconclass12)", tooltip="Official Iconclass notation 12: non-Christian religions (including institutions, customs and antiquities).", fillcolor="#cfe2f3"];
  "iconclass_Jurjis_led_to_King" [label="Jurjis led in chains to the King of Mosul (iconclass_Jurjis_led_to_King)", tooltip="Project-specific extension for the Islamic narrative of the Prophet Jurjis      (Jirjis) being led in chains to the King of Mosul after refusing to worship idols.      In Islamic tradition he is miraculously protected from the subsequent tortures.      This visual formula appears in Ilkhanid painting (notably the Edinburgh Jāmiʿ al-Tawārīkh).", fillcolor="#cfe2f3"];
  "iconclass11H_George" [label="Saint George (iconclass11H_George)", tooltip="Official Iconclass notation for Saint George (11H(GEORGE)).", fillcolor="#cfe2f3"];
  "iconclass48" [label="art (iconclass48)", tooltip="Official Iconclass notation 48: art.", fillcolor="#cfe2f3"];
  "iconclass4" [label="Society, Civilization, Culture (iconclass4)", tooltip="Society, Civilization, Culture", fillcolor="#cfe2f3"];
  "iconclass47" [label="crafts and industries (iconclass47)", tooltip="Official Iconclass notation 47: crafts and industries.", fillcolor="#cfe2f3"];
  "iconclass41" [label="material aspects of daily life (iconclass41)", tooltip="Official Iconclass notation 41: material aspects of daily life.", fillcolor="#cfe2f3"];
  "iconclass45" [label="warfare; military affairs (iconclass45)", tooltip="Official Iconclass notation 45: warfare; military affairs.", fillcolor="#cfe2f3"];
  "iconclass71A41" [label="Temptation and Fall (scenes with Eve alone) (iconclass71A41)", tooltip="Official Iconclass notation 71A41: Temptation and Fall (scenes with Eve alone).", fillcolor="#cfe2f3"];
  "iconclass71A42" [label="Temptation and Fall (scenes with both Adam and Eve) (iconclass71A42)", tooltip="Official Iconclass notation 71A42: Temptation and Fall (scenes with both Adam and Eve).", fillcolor="#cfe2f3"];
  "iconclass71A412" [label="Eve takes the fruit (iconclass71A412)", tooltip="Official Iconclass notation 71A412: Eve takes the fruit.", fillcolor="#cfe2f3"];
  "iconclass71A411" [label="the serpent tries to persuade Eve to take some of the fruit (iconclass71A411)", tooltip="Official Iconclass notation 71A411: the serpent tries to persuade Eve to take some of the fruit (usually an apple).", fillcolor="#cfe2f3"];
  "iconclass71A424" [label="Adam and Eve discover their nakedness (iconclass71A424)", tooltip="Official Iconclass notation 71A424: Adam and Eve discover their nakedness; they cover themselves with their hands or with leaves.", fillcolor="#cfe2f3"];
  "iconclass71A423" [label="Adam and Eve holding (and possibly eating) the fruit (iconclass71A423)", tooltip="Official Iconclass notation 71A423: Adam and Eve holding (and possibly eating) the fruit.", fillcolor="#cfe2f3"];
  "iconclass71A422" [label="Eve offers the fruit to Adam (iconclass71A422)", tooltip="Official Iconclass notation 71A422: Eve offers the fruit to Adam.", fillcolor="#cfe2f3"];
  "iconclass71A421" [label="Eve takes the fruit from the serpent (or the tree) in the presence of Adam (iconclass71A421)", tooltip="Official Iconclass notation 71A421: Eve takes the fruit from the serpent (or the tree) in the presence of Adam (who may be trying to stop her).", fillcolor="#cfe2f3"];
  "iconclass71A52" [label="Adam and Eve hide themselves (iconclass71A52)", tooltip="Official Iconclass notation 71A52: Adam and Eve hide themselves.", fillcolor="#cfe2f3"];
  "iconclass71A53" [label="God calls Adam (iconclass71A53)", tooltip="Official Iconclass notation 71A53: God calls Adam.", fillcolor="#cfe2f3"];
  "iconclass71A54" [label="God confronts / reproves Adam and Eve (iconclass71A54)", tooltip="Official Iconclass notation 71A54: God confronts / reproves Adam and Eve.", fillcolor="#cfe2f3"];
  "iconclass71A56" [label="God makes garments of skins for Adam and Eve (iconclass71A56)", tooltip="Official Iconclass notation 71A56: God makes garments of skins for Adam and Eve.", fillcolor="#cfe2f3"];
  "iconclass71A51" [label="God walks in the garden (iconclass71A51)", tooltip="Official Iconclass notation 71A51: God walks in the garden.", fillcolor="#cfe2f3"];
  "iconclass71A55" [label="the punishments / curses pronounced on the serpent, Eve and Adam (iconclass71A55)", tooltip="Official Iconclass notation 71A55: the punishments / curses pronounced on the serpent, Eve and Adam.", fillcolor="#cfe2f3"];
  "iconclass41D266" [label="ornaments, jewels (iconclass41D266)", tooltip="Official Iconclass notation 41D266: ornaments, jewels.", fillcolor="#cfe2f3"];
  "iconclass41D26" [label="accessories (~ clothing) (iconclass41D26)", tooltip="Official Iconclass notation 41D26: accessories (~ clothing).", fillcolor="#cfe2f3"];
  "iconclass11G2" [label="activities of angels (in heaven) (iconclass11G2)", tooltip="Official Iconclass notation 11G2: activities of angels (in heaven).", fillcolor="#cfe2f3"];
  "iconclass11G3" [label="angels fighting (iconclass11G3)", tooltip="Official Iconclass notation 11G3: angels fighting.", fillcolor="#cfe2f3"];
  "iconclass11G4" [label="specific aspects of angels, e.g. intervening in human affairs (iconclass11G4)", tooltip="Official Iconclass notation 11G4:      specific aspects of angels, e.g. intervening in human affairs.     Preferred child for angels at the birth of the Prophet,      angels handing the infant, or angels addressing a prophet.", fillcolor="#cfe2f3"];
  "iconclass11G1" [label="the nine choirs of angels, hierarchy of angels (iconclass11G1)", tooltip="Official Iconclass notation 11G1: the nine choirs of angels, hierarchy of angels.", fillcolor="#cfe2f3"];
  "iconclass25FF" [label="fabulous animals (iconclass25FF)", tooltip="Official Iconclass notation 25FF:      fabulous animals (sometimes wrongly called 'grotesques'); 'Mostri' (Ripa).     Doubled F marks the fabulous counterpart of 25F.", fillcolor="#cfe2f3"];
  "iconclass25F" [label="animals (iconclass25F)", tooltip="Official Iconclass notation 25F: animals.", fillcolor="#cfe2f3"];
  "iconclass48C1621" [label="arcade ~ architecture (iconclass48C1621)", tooltip="arcade ~ architecture", fillcolor="#cfe2f3"];
  "iconclass48C162" [label="arch, archivolt ~ architecture (iconclass48C162)", tooltip="Official Iconclass notation 48C162: arch, archivolt ~ architecture.", fillcolor="#cfe2f3"];
  "iconclass48C1624" [label="concha ~ architecture (iconclass48C1624)", tooltip="concha ~ architecture", fillcolor="#cfe2f3"];
  "iconclass48C1623" [label="dome ~ architecture (iconclass48C1623)", tooltip="Official Iconclass notation 48C1623: dome ~ architecture.     Use for gumbad / qubba as an architectural motif      in manuscript painting and architectural views.", fillcolor="#cfe2f3"];
  "iconclass48C1622" [label="vault ~ architecture (iconclass48C1622)", tooltip="vault ~ architecture", fillcolor="#cfe2f3"];
  "iconclass48C16" [label="civic architecture (iconclass48C16)", tooltip="Official Iconclass notation 48C16: civic architecture.", fillcolor="#cfe2f3"];
  "iconclass48C1" [label="architecture (iconclass48C1)", tooltip="Official Iconclass notation 48C1: architecture.", fillcolor="#cfe2f3"];
  "iconclass48A" [label="art and the public; styles and ornaments (iconclass48A)", tooltip="Official Iconclass notation 48A: art and the public; styles and ornaments.", fillcolor="#cfe2f3"];
  "iconclass48C" [label="the arts; artists (iconclass48C)", tooltip="Official Iconclass notation 48C: the arts; artists.", fillcolor="#cfe2f3"];
  "iconclass48A9" [label="stylistic and formal differentiation of art (iconclass48A9)", tooltip="Official Iconclass notation 48A9: stylistic and formal differentiation of art.", fillcolor="#cfe2f3"];
  "iconclass47G5" [label="building materials (iconclass47G5)", tooltip="Official Iconclass notation 47G5: building materials.", fillcolor="#cfe2f3"];
  "iconclass47G" [label="building activities (iconclass47G)", tooltip="Official Iconclass notation 47G: building activities.", fillcolor="#cfe2f3"];
