  "iconclass71C131" [label="the sacrifice of Isaac (iconclass71C131)", tooltip="the sacrifice of Isaac", fillcolor="#cfe2f3"];
  "iconclass71D14" [label="Joseph in prison (Genesis 39:21-40) (iconclass71D14)", tooltip="Joseph in prison (Genesis 39:21-40)", fillcolor="#cfe2f3"];
  "iconclass71D11" [label="Joseph incurs the hatred of his brothers (Genesis 37:1-11) (iconclass71D11)", tooltip="Joseph incurs the hatred of his brothers (Genesis 37:1-11)", fillcolor="#cfe2f3"];
  "iconclass71D12" [label="Joseph sold into slavery and taken to Egypt (Genesis 37:12-35) (iconclass71D12)", tooltip="Joseph sold into slavery and taken to Egypt (Genesis 37:12-35)", fillcolor="#cfe2f3"];
  "iconclass71D15" [label="Pharaoh's dreams interpreted (Genesis 41:1-36) (iconclass71D15)", tooltip="Pharaoh's dreams interpreted (Genesis 41:1-36)", fillcolor="#cfe2f3"];
  "iconclass71D16" [label="elevation and marriage of Joseph (Genesis 41:37-57) (iconclass71D16)", tooltip="elevation and marriage of Joseph (Genesis 41:37-57)", fillcolor="#cfe2f3"];
  "iconclass71D21" [label="Jacob and his family go to Egypt (Genesis 46) (iconclass71D21)", tooltip="Jacob and his family go to Egypt (Genesis 46)", fillcolor="#cfe2f3"];
  "iconclass71D25" [label="Jacob's death (Genesis 49–50) (iconclass71D25)", tooltip="Jacob's death (Genesis 49–50)", fillcolor="#cfe2f3"];
  "iconclass71D24" [label="Jacob's last days / blessing of the sons (Genesis 47–49) (iconclass71D24)", tooltip="Jacob's last days / blessing of the sons (Genesis 47–49)", fillcolor="#cfe2f3"];
  "iconclass71B33" [label="the Flood and destruction of mankind (iconclass71B33)", tooltip="the Flood and destruction of mankind", fillcolor="#cfe2f3"];
  "iconclass71B32" [label="the building of the ark, and the embarkation (iconclass71B32)", tooltip="the building of the ark, and the embarkation", fillcolor="#cfe2f3"];
  "iconclass71B34" [label="the disembarkation ~ story of Noah (iconclass71B34)", tooltip="the disembarkation ~ story of Noah", fillcolor="#cfe2f3"];
  "iconclass71I_PersianCourt" [label="Solomon’s court and throne in Persian manuscript painting (iconclass71I_PersianCourt)", tooltip="Solomon’s court and throne in Persian manuscript painting", fillcolor="#cfe2f3"];
  "iconclass71I6" [label="the visit of the Queen of Sheba (iconclass71I6)", tooltip="the visit of the Queen of Sheba", fillcolor="#cfe2f3"];
  "iconclass71B331" [label="the ark is floating on the waters, while life on earth is destroyed (iconclass71B331)", tooltip="Official Iconclass notation 71B331:      the ark is floating on the waters, while life on earth is destroyed ~ story of Noah.     This is the primary official term for scenes showing Noah and his family      visible on the deck (or at the windows) of the ark during the Flood.", fillcolor="#cfe2f3"];
  "iconclass_Ashab_al_Kahf" [label="Aṣḥāb al-Kahf (Companions of the Cave) (iconclass_Ashab_al_Kahf)", tooltip="Project-specific extension for the Qur’anic version of the Seven Sleepers      (Sūrat al-Kahf 18:9–26). Emphasises the Islamic narrative details: the 309-year sleep,      the dog (Qiṭmīr), and the alternative location of the cave in Toyug (Central Asia)      rather than Ephesus. Used when the painting or text clearly follows the Islamic tradition.", fillcolor="#cfe2f3"];
  "iconclass71E1_MosesSeventyElders" [label="Moses and the seventy elders hearing the voice of God from the clouds (iconclass71E1_MosesSeventyElders)", tooltip="Project-specific extension for the scene in which Moses (Musa),      standing or seated on a rock/mountain and often wearing a prophetic veil,      hears the voice of God emerging from the clouds, while the seventy elders      (or learned men) lie prostrate below him.      Mountains form the background.      This composition is particularly characteristic of Ilkhanid manuscript painting      (notably the Edinburgh Jāmiʿ al-Tawārīkh) and reflects both Biblical      (Exodus 24; Numbers 11) and Islamic narrative traditions.", fillcolor="#cfe2f3"];
  "iconclass71E_Midian" [label="Shuaib / Prophet of Midian (Islamic tradition) (iconclass71E_Midian)", tooltip="Project-specific extension covering the Quranic prophet Shuaib      (identified with or related to Jethro).      Captures the distinctive themes of preaching to Midian,      fair weights and measures, and the destruction of the people of Midian/Aykah.", fillcolor="#cfe2f3"];
  "iconclass71E114" [label="the burning bush (iconclass71E114)", tooltip="the burning bush", fillcolor="#cfe2f3"];
  "iconclass71E11" [label="the finding of Moses / Moses in the bulrushes (iconclass71E11)", tooltip="the finding of Moses / Moses in the bulrushes", fillcolor="#cfe2f3"];
  "iconclass71E1124" [label="the finding of Moses: Pharaoh's daughter discovers the child in the river (iconclass71E1124)", tooltip="Official Iconclass notation for the discovery of the infant Moses      floating in a basket on the Nile by Pharaoh’s daughter and her maidens.      In Persian and Islamic manuscript painting the scene often shows Queen Bithia      (with long dark hair) and an Israelite nurse of lighter complexion.", fillcolor="#cfe2f3"];
  "iconclass71V42" [label="Jonah under the gourd plant (iconclass71V42)", tooltip="Jonah (Yunus) reclining in the shade of the gourd plant (or vine)      that God caused to grow to shelter him after he was cast up by the great fish      (Jonah 4:6).      The reclining pose is continuous with early Christian iconography.      In Persian and Islamic manuscripts the sea creature is frequently shown as a large fish.", fillcolor="#cfe2f3"];
  "iconclass71A821" [label="Abel's death (iconclass71A821)", tooltip="Official Iconclass notation 71A821: Abel's death.", fillcolor="#cfe2f3"];
  "iconclass71A82" [label="the killing of Abel: Cain slays him with a stone, a club or a jaw-bone, alternatively with a spade or another tool as weapon (iconclass71A82)", tooltip="Official Iconclass notation 71A82:      the killing of Abel: Cain slays him with a stone, a club or a jaw-bone,      alternatively with a spade or another tool as weapon.", fillcolor="#cfe2f3"];
  "iconclass71A824" [label="Adam and Eve bury Abel (iconclass71A824)", tooltip="Official Iconclass notation 71A824: Adam and Eve bury Abel.", fillcolor="#cfe2f3"];
  "iconclass71A823" [label="Adam and Eve discover the dead body of Abel and grieve over it (iconclass71A823)", tooltip="Official Iconclass notation 71A823: Adam and Eve discover the dead body of Abel and grieve over it.", fillcolor="#cfe2f3"];
  "iconclass71A822" [label="Cain buries Abel (iconclass71A822)", tooltip="Official Iconclass notation 71A822: Cain buries Abel.", fillcolor="#cfe2f3"];
  "iconclass71C131_Ismail" [label="the sacrifice of Ismail (Islamic tradition) (iconclass71C131_Ismail)", tooltip="the sacrifice of Ismail (Islamic tradition)", fillcolor="#cfe2f3"];
  "iconclass71A84" [label="later life of Cain (iconclass71A84)", tooltip="later life of Cain", fillcolor="#cfe2f3"];
  "iconclass71A83" [label="the curse and flight of Cain (iconclass71A83)", tooltip="the curse and flight of Cain", fillcolor="#cfe2f3"];
  "iconclass71A81" [label="the sacrifice of Cain and Abel: Abel offers a lamb, Cain usually a sheaf of corn (iconclass71A81)", tooltip="the sacrifice of Cain and Abel: Abel offers a lamb, Cain usually a sheaf of corn", fillcolor="#cfe2f3"];
  "iconclass45C16" [label="bows and arrows; crossbow (iconclass45C16)", tooltip="Official Iconclass notation 45C16:      bows and arrows; crossbow (archery weapons).     Specific types are added in parentheses, e.g. 45C16(CROSSBOW).", fillcolor="#cfe2f3"];
