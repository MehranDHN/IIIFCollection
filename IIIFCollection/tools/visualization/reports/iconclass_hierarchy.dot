  "iconclass11H_SevenSleepers" [label="the Seven Sleepers of Ephesus (iconclass11H_SevenSleepers)", tooltip="Official Iconclass notation for the Seven Sleepers (children) of Ephesus      (11H(SEVEN SLEEPERS)). Christian tradition of the youths walled up in a cave under Decius      and miraculously awakened under Theodosius II.", fillcolor="#cfe2f3"];
  "iconclass22C3115" [label="(golden) thread as nimbus (iconclass22C3115)", tooltip="(golden) thread as nimbus", fillcolor="#cfe2f3"];
  "iconclass22C311" [label="nimbus, halo ~ radiance emanating from persons or things (iconclass22C311)", tooltip="Official Iconclass notation 22C311:      nimbus, halo ~ radiance emanating from persons or things.     Use for circular / disc haloes and, as relatedMatch,      for the flaming nimbus of prophets in Islamic/Persian painting.", fillcolor="#cfe2f3"];
