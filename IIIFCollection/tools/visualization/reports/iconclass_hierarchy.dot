  "iconclass48C161" [label="town hall, guildhall (iconclass48C161)", tooltip="Official Iconclass notation 48C161:      town hall, guildhall (civic / municipal architecture).", fillcolor="#cfe2f3"];
  "iconclass47G533" [label="concrete ~ building material (iconclass47G533)", tooltip="concrete ~ building material", fillcolor="#cfe2f3"];
  "iconclass47G534" [label="glass ~ building material (iconclass47G534)", tooltip="glass ~ building material", fillcolor="#cfe2f3"];
  "iconclass47G531" [label="mud ~ building material (iconclass47G531)", tooltip="mud ~ building material", fillcolor="#cfe2f3"];
  "iconclass47G532" [label="tiles, bricks ~ building material (iconclass47G532)", tooltip="Official Iconclass notation 47G532:      tiles, bricks ~ building material.     Use for brick and tile as depicted material      (walls, paved courts, kiln scenes, architectural fabric).", fillcolor="#cfe2f3"];
  "iconclass41D2" [label="clothes, costume (iconclass41D2)", tooltip="Official Iconclass notation 41D2: clothes, costume.", fillcolor="#cfe2f3"];
