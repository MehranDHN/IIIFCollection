### 12I – Islam

mdhn:iconclass12I a mdhn:IconclassTerm ;
    rdfs:label "Islam, Mohammedanism"@en ,
               "اسلام"@fa ;
    
    rdfs:comment """Official Iconclass notation 12I: Islam, Mohammedanism.
    Official parent for Islamic places of worship, ritual, and functionaries.
    The historical correlate 'Mohammedanism' is retained only as the Iconclass label."""@en ;
    
    mdhn:iconclassNotation "12I" ;
    skos:exactMatch <https://iconclass.org/12I> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q432> ;  # Islam
    
    mdhn:hasIconclassBroader mdhn:iconclass12 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


