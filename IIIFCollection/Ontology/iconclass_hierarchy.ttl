    rdfs:comment """Official Iconclass notation 25FF422: 
    dragon (large fabulous serpent, sometimes with wings and legs).
    Preferred official term for azhdahā / tannīn-type dragons 
    in Persian and Islamic manuscript painting.
    Contrast with 25FF411 (lizard-like dragon)."""@en ;
    
    mdhn:iconclassNotation "25FF422" ;
    skos:exactMatch iconclass:25FF422 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass25FF42 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


