    mdhn:iconclassNotation "71D14" ;
    skos:exactMatch iconclass:71D14 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D15 a mdhn:IconclassTerm ;
    rdfs:label "Pharaoh's dreams interpreted (Genesis 41:1-36)"@en ,
               "تعبیر خواب فرعون توسط یوسف"@fa ;
    mdhn:iconclassNotation "71D15" ;
    skos:exactMatch iconclass:71D15 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D16 a mdhn:IconclassTerm ;
