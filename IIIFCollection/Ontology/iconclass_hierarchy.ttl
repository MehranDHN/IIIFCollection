    mdhn:iconclassNotation "71A8" ;
    skos:exactMatch iconclass:71A8 ;
    skos:related mdhn:Story_of_Cain_and_Abel ;
    mdhn:hasIconclassBroader mdhn:iconclass71A ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# Immediate children of 71A8 (so the hierarchy can be extended)
