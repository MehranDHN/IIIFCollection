    mdhn:iconclassNotation "71A81" ;
    skos:exactMatch iconclass:71A81 ;
    mdhn:hasIconclassBroader mdhn:iconclass71A8 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71A82 a mdhn:IconclassTerm ;
    rdfs:label "the killing of Abel: Cain slays him with a stone, a club or a jaw-bone, alternatively with a spade or another tool as weapon"@en,
               "قتل هابیل توسط قابیل"@fa  ;
    rdfs:comment """Official Iconclass notation 71A82: 
    the killing of Abel: Cain slays him with a stone, a club or a jaw-bone, 
    alternatively with a spade or another tool as weapon."""@en ;               
    mdhn:iconclassNotation "71A82" ;
    skos:exactMatch iconclass:71A82 ;
    skos:exactMatch iconclass:71A82 ;
    mdhn:hasIconclassBroader mdhn:iconclass71A8 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71A821 a mdhn:IconclassTerm ;
    rdfs:label "Abel's death"@en ,
               "مرگ هابیل"@fa ;    
