# Abraham / ابراهیم (71C1)
#################################################################  
mdhn:iconclass71C1 a mdhn:IconclassTerm ;
    rdfs:label "story of Abraham"@en ,
               "داستان ابراهیم"@fa ;
    mdhn:iconclassNotation "71C1" ;
    skos:exactMatch iconclass:71C1 ;
    skos:closeMatch wd:Q9181 ;           # Abraham
    skos:relatedMatch wd:Q9181 ;
    mdhn:hasIconclassBroader mdhn:iconclass71C ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# Sacrifice of Isaac / Ismail – critical shared / diverging point
mdhn:iconclass71C131 a mdhn:IconclassTerm ;
