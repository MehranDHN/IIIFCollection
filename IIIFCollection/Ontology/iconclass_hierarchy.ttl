


@prefix mdhn:       <http://example.com/mdhn/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix iconclass:  <https://iconclass.org/> .
@prefix wd:         <http://www.wikidata.org/entity/> .
@prefix aat:        <http://vocab.getty.edu/aat/> .

#################################################################
# Joseph / Yusuf cycle – Iconclass 71D hierarchy
# Primed for IIIFDexir association with manuscripts, canvases & content elements
#################################################################

# ------------------------------------------------------------
# Root of the cycle
# ------------------------------------------------------------

### 1 – Religion and Magic

mdhn:iconclass1 a mdhn:IconclassTerm ;
    rdfs:label "Religion and Magic"@en ,
               "دین و جادو"@fa ;
    
    rdfs:comment "Official Iconclass notation 1: Religion and Magic."@en ;
    
    mdhn:iconclassNotation "1" ;
    skos:exactMatch iconclass:1 ;
    
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11 a mdhn:IconclassTerm ;
    rdfs:label "Christian religion"@en ,
               "دین مسیحی"@fa ;
    
    rdfs:comment "Official Iconclass notation 11: Christian religion."@en ;
    
    mdhn:iconclassNotation "11" ;
    skos:exactMatch iconclass:11 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 11 – Christian religion

mdhn:iconclass11 a mdhn:IconclassTerm ;
    rdfs:label "Christian religion"@en ,
               "دین مسیحی"@fa ;
    
    rdfs:comment """Official Iconclass notation 11: Christian religion.
    Parent of angels (11G), saints (11H), and prophets not in biblical context (11I).
    Use as broader only; pictorial scenes of angels in Islamic manuscripts 
    still take 11G as the visual class."""@en ;
    
    mdhn:iconclassNotation "11" ;
    skos:exactMatch iconclass:11 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 11G – Angels (requested term)

mdhn:iconclass11G a mdhn:IconclassTerm ;
    rdfs:label "angels"@en ,
               "فرشتگان"@fa ;
    
    rdfs:comment """Official Iconclass notation 11G: angels.
    Official visual class for winged celestial messengers.
    Use also for malāʾika in Persian/Islamic painting 
    (birth of the Prophet, Revelation scenes, etc.)."""@en ;
    
    mdhn:iconclassNotation "11G" ;
    skos:exactMatch iconclass:11G ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### Direct children of 11G

mdhn:iconclass11G1 a mdhn:IconclassTerm ;
    rdfs:label "the nine choirs of angels, hierarchy of angels"@en ,
               "نه گروه فرشتگان، سلسله‌مراتب فرشتگان"@fa ;
    
    rdfs:comment "Official Iconclass notation 11G1: the nine choirs of angels, hierarchy of angels."@en ;
    
    mdhn:iconclassNotation "11G1" ;
    skos:exactMatch iconclass:11G1 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11G2 a mdhn:IconclassTerm ;
    rdfs:label "activities of angels (in heaven)"@en ,
               "اعمال فرشتگان (در آسمان)"@fa ;
    
    rdfs:comment "Official Iconclass notation 11G2: activities of angels (in heaven)."@en ;
    
    mdhn:iconclassNotation "11G2" ;
    skos:exactMatch iconclass:11G2 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11G3 a mdhn:IconclassTerm ;
    rdfs:label "angels fighting"@en ,
               "نبرد فرشتگان"@fa ;
    
    rdfs:comment "Official Iconclass notation 11G3: angels fighting."@en ;
    
    mdhn:iconclassNotation "11G3" ;
    skos:exactMatch iconclass:11G3 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11G4 a mdhn:IconclassTerm ;
    rdfs:label "specific aspects of angels, e.g. intervening in human affairs"@en ,
               "جنبه‌های خاص فرشتگان، مثلاً دخالت در امور انسان"@fa ;
    
    rdfs:comment """Official Iconclass notation 11G4: 
    specific aspects of angels, e.g. intervening in human affairs.
    Preferred child for angels at the birth of the Prophet, 
    angels handing the infant, or angels addressing a prophet."""@en ;
    
    mdhn:iconclassNotation "11G4" ;
    skos:exactMatch iconclass:11G4 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

### 12 – Non-Christian religions

mdhn:iconclass12 a mdhn:IconclassTerm ;
    rdfs:label "non-Christian religions (including institutions, customs and antiquities)"@en ,
               "ادیان غیرمسیحی (شامل نهادها، آداب و آثار)"@fa ;
    
    rdfs:comment "Official Iconclass notation 12: non-Christian religions (including institutions, customs and antiquities)."@en ;
    
    mdhn:iconclassNotation "12" ;
    skos:exactMatch iconclass:12 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 12I – Islam

mdhn:iconclass12I a mdhn:IconclassTerm ;
    rdfs:label "Islam, Mohammedanism"@en ,
               "اسلام"@fa ;
    
    rdfs:comment """Official Iconclass notation 12I: Islam, Mohammedanism.
    Official parent for Islamic places of worship, ritual, and functionaries.
    The historical correlate 'Mohammedanism' is retained only as the Iconclass label."""@en ;
    
    mdhn:iconclassNotation "12I" ;
    skos:exactMatch iconclass:12I ;
    
    mdhn:hasIconclassBroader mdhn:iconclass12 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 12I6 – Places and objects of worship ~ Islam

mdhn:iconclass12I6 a mdhn:IconclassTerm ;
    rdfs:label "places and objects of worship ~ Islam, Mohammedanism"@en ,
               "اماکن و اشیاء عبادت ~ اسلام"@fa ;
    
    rdfs:comment "Official Iconclass notation 12I6: places and objects of worship ~ Islam, Mohammedanism."@en ;
    
    mdhn:iconclassNotation "12I6" ;
    skos:exactMatch iconclass:12I6 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass12I ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 12I61 – Temple, shrine ~ Islam (requested term)

mdhn:iconclass12I61 a mdhn:IconclassTerm ;
    rdfs:label "temple, shrine ~ Islam, Mohammedanism"@en ,
               "معبد، زیارتگاه ~ اسلام"@fa ;
    
    rdfs:comment """Official Iconclass notation 12I61: 
    temple, shrine ~ Islam, Mohammedanism.
    Official class for mosque, masjid, shrine and ziyārat as 
    depicted architecture (keywords in Iconclass include mosque, minaret).
    Pair with 48C1623 when a dome is the visual focus."""@en ;
    
    mdhn:iconclassNotation "12I61" ;
    skos:exactMatch iconclass:12I61 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass12I6 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### Siblings under 12I6

mdhn:iconclass12I63 a mdhn:IconclassTerm ;
    rdfs:label "statues, paintings, etc. as objects of worship (Islam, Mohammedanism)"@en ,
               "تندیس، نقاشی و مانند آن به‌مثابه اشیاء عبادت (اسلام)"@fa ;
    mdhn:iconclassNotation "12I63" ;
    skos:exactMatch iconclass:12I63 ;
    mdhn:hasIconclassBroader mdhn:iconclass12I6 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass12I64 a mdhn:IconclassTerm ;
    rdfs:label "other holy places ~ Islam, Mohammedanism"@en ,
               "دیگر مکان‌های مقدس ~ اسلام"@fa ;
    mdhn:iconclassNotation "12I64" ;
    skos:exactMatch iconclass:12I64 ;
    mdhn:hasIconclassBroader mdhn:iconclass12I6 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


