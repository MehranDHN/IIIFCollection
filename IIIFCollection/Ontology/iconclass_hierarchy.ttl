# Moses / موسی (71E1)
#################################################################  
mdhn:iconclass71E1 a mdhn:IconclassTerm ;
    rdfs:label "the book Exodus: story of Moses and Aaron"@en ,
               "داستان موسی و هارون"@fa ;
    mdhn:iconclassNotation "71E1" ;
    skos:exactMatch iconclass:71E1 ;
    skos:closeMatch wd:Q9077 ;           # Moses
