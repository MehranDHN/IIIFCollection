    skos:exactMatch iconclass:71D1 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# Key scenes in Part I that appear frequently in Persian manuscripts
mdhn:iconclass71D11 a mdhn:IconclassTerm ;
