### 12I61 – Temple, shrine ~ Islam (requested term)

mdhn:iconclass12I61 a mdhn:IconclassTerm ;
    rdfs:label "temple, shrine ~ Islam, Mohammedanism"@en ,
               "معبد، زیارتگاه ~ اسلام"@fa ;
    
    rdfs:comment """Official Iconclass notation 12I61: 
    temple, shrine ~ Islam, Mohammedanism.
    Official class for mosque, masjid, shrine and ziyārat as 
    depicted architecture (keywords in Iconclass include mosque, minaret).
    Pair with 48C1623 when a dome is the visual focus."""@en ;
    
    mdhn:iconclassNotation "12I61" ;
    skos:exactMatch <https://iconclass.org/12I61> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q32815> ;  # mosque
    
    mdhn:hasIconclassBroader mdhn:iconclass12I6 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


