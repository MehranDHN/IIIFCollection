


@prefix mdhn:       <http://example.com/mdhn/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix iconclass:  <https://iconclass.org/> .
@prefix wd:         <http://www.wikidata.org/entity/> .
@prefix aat:        <http://vocab.getty.edu/aat/> .

#################################################################
# Joseph / Yusuf cycle – Iconclass 71D hierarchy
# Primed for IIIFDexir association with manuscripts, canvases & content elements
#################################################################

# ------------------------------------------------------------
# Root of the cycle
# ------------------------------------------------------------

### Missing official Iconclass parents

mdhn:iconclass11 a mdhn:IconclassTerm ;
    rdfs:label "Christian religion"@en ,
               "دین مسیحی"@fa ;
    
    rdfs:comment "Official Iconclass notation 11: Christian religion."@en ;
    
    mdhn:iconclassNotation "11" ;
    skos:exactMatch <https://iconclass.org/11> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71B a mdhn:IconclassTerm ;
    rdfs:label "Genesis from the descendants of Cain and Seth to Abraham"@en ,
               "پیدایش از نوادگان قابیل و شیث تا ابراهیم"@fa ;
    
    rdfs:comment "Official Iconclass notation 71B: Genesis from the descendants of Cain and Seth to Abraham."@en ;
    
    mdhn:iconclassNotation "71B" ;
    skos:exactMatch <https://iconclass.org/71B> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71C a mdhn:IconclassTerm ;
    rdfs:label "Genesis: the patriarchs"@en ,
               "پیدایش: پدرسالاران"@fa ;
    
    rdfs:comment "Official Iconclass notation 71C: Genesis: the patriarchs."@en ;
    
    mdhn:iconclassNotation "71C" ;
    skos:exactMatch <https://iconclass.org/71C> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71E a mdhn:IconclassTerm ;
    rdfs:label "Exodus, Leviticus, Numbers, Deuteronomy, Joshua"@en ,
               "خروج، لاویان، اعداد، تثنیه، یوشع"@fa ;
    
    rdfs:comment """Official Iconclass notation 71E: 
    Exodus, Leviticus, Numbers, Deuteronomy, Joshua: 
    from the bondage of the Israelites in Egypt to their settlement in Canaan."""@en ;
    
    mdhn:iconclassNotation "71E" ;
    skos:exactMatch <https://iconclass.org/71E> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71V a mdhn:IconclassTerm ;
    rdfs:label "the book of Jonah"@en ,
               "کتاب یونس"@fa ;
    
    rdfs:comment "Official Iconclass notation 71V: the book of Jonah."@en ;
    
    mdhn:iconclassNotation "71V" ;
    skos:exactMatch <https://iconclass.org/71V> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass98 a mdhn:IconclassTerm ;
    rdfs:label "Classical Mythology and Ancient History"@en ,
               "اساطیر کلاسیک و تاریخ باستان"@fa ;
    
    rdfs:comment "Official Iconclass notation 98: Classical Mythology and Ancient History (male classical heroes)."@en ;
    
    mdhn:iconclassNotation "98" ;
    skos:exactMatch <https://iconclass.org/98> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass9 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass1 a mdhn:IconclassTerm ;
    rdfs:label "Religion and Magic"@en ;
    mdhn:iconclassNotation "1" ;
    skos:exactMatch <https://iconclass.org/1> ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass9 a mdhn:IconclassTerm ;
    rdfs:label "Classical Mythology and Ancient History"@en ;
    mdhn:iconclassNotation "9" ;
    skos:exactMatch <https://iconclass.org/9> ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71 a mdhn:IconclassTerm ;
    rdfs:label "Old Testament"@en ,
               "عهد عتیق"@fa ;
    mdhn:iconclassNotation "71" ;
    skos:exactMatch <https://iconclass.org/71> ;
    mdhn:hasIconclassBroader mdhn:iconclass7 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D a mdhn:IconclassTerm ;
    rdfs:label "Genesis: the story of Joseph"@en ,
               "داستان یوسف (پیدایش)"@fa ;
    rdfs:comment "Iconclass 71D – full story of Joseph (son of Jacob). Central shared Biblical–Quranic narrative; highly relevant for Persian Yusuf va Zulaykha cycles."@en ;
    mdhn:iconclassNotation "71D" ;
    skos:exactMatch iconclass:71D ;
    skos:exactMatch <https://iconclass.org/71D> ;      
    skos:closeMatch wd:Q8423 ;                    # Joseph (son of Jacob)
    skos:relatedMatch wd:Q3350827 ;               # Yusuf and Zulaikha
    skos:relatedMatch mdhn:Yusuf_and_Zulaikha ;   # your existing narrative episode
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11H a mdhn:IconclassTerm ;
    rdfs:label "male saints"@en ,
               "قدیسان مرد"@fa ;
    
    rdfs:comment "Iconclass division 11H: male saints (including named individual saints such as Saint George, the Seven Sleepers, etc.)."@en ;    
    mdhn:iconclassNotation "11H" ;
    skos:exactMatch <https://iconclass.org/11H> ;    
    mdhn:hasIconclassBroader mdhn:iconclass11 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .    

mdhn:iconclass_PropheticBirths a mdhn:IconclassTerm ;
    rdfs:label "Births of Prophets"@en ,
               "تولد پیامبران"@fa ;    
    rdfs:comment """Project-specific higher-level grouping for the birth scenes of prophets 
    in Islamic narrative tradition (and related Biblical figures when treated in the same 
    pictorial cycles). 
    Used as a broader term for limited-scope Iconclass entries such as the Birth of 
    the Prophet Muhammad. 
    No official Iconclass division corresponds exactly to this category."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

mdhn:iconclass_ArabianProphets a mdhn:IconclassTerm ;
    rdfs:label "Arabian Prophets"@en ,
               "پیامبران عرب"@fa ;    
    rdfs:comment """Project-specific higher-level grouping for the Arab prophets 
    of the Islamic tradition (Hūd, Ṣāliḥ, Shuʿayb, and related figures) whose 
    narratives are primarily associated with the Arabian peninsula and appear 
    in Qiṣaṣ al-Anbiyāʾ and related pictorial cycles. 
    No official Iconclass division corresponds to this category."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

# ------------------------------------------------------------
# Part I (youth → rise in Egypt)
# ------------------------------------------------------------
mdhn:iconclass71D1 a mdhn:IconclassTerm ;
    rdfs:label "story of Joseph (part I)"@en ,
               "داستان یوسف (بخش اول)"@fa ;
    mdhn:iconclassNotation "71D1" ;
    skos:exactMatch iconclass:71D1 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# Key scenes in Part I that appear frequently in Persian manuscripts
mdhn:iconclass71D11 a mdhn:IconclassTerm ;
    rdfs:label "Joseph incurs the hatred of his brothers (Genesis 37:1-11)"@en ,
               "حسادت برادران یوسف"@fa ;
    mdhn:iconclassNotation "71D11" ;
    skos:exactMatch iconclass:71D11 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D12 a mdhn:IconclassTerm ;
    rdfs:label "Joseph sold into slavery and taken to Egypt (Genesis 37:12-35)"@en ,
               "فروخته شدن یوسف و بردن او به مصر"@fa ;
    mdhn:iconclassNotation "71D12" ;
    skos:exactMatch iconclass:71D12 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D13 a mdhn:IconclassTerm ;
    rdfs:label "Joseph in Potiphar's house; the chastity of Joseph (Genesis 39)"@en ,
               "یوسف در خانه پوتیفار / پاکدامنی یوسف"@fa ;
    rdfs:comment "Extremely important for Persian tradition – the core of the Zulaykha narrative."@en ;
    mdhn:iconclassNotation "71D13" ;
    skos:exactMatch iconclass:71D13 ;
    skos:relatedMatch wd:Q3350827 ;               # Yusuf and Zulaikha
    skos:relatedMatch mdhn:Yusuf_and_Zulaikha ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D14 a mdhn:IconclassTerm ;
    rdfs:label "Joseph in prison (Genesis 39:21-40)"@en ,
               "یوسف در زندان"@fa ;
    mdhn:iconclassNotation "71D14" ;
    skos:exactMatch iconclass:71D14 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D15 a mdhn:IconclassTerm ;
    rdfs:label "Pharaoh's dreams interpreted (Genesis 41:1-36)"@en ,
               "تعبیر خواب فرعون توسط یوسف"@fa ;
    mdhn:iconclassNotation "71D15" ;
    skos:exactMatch iconclass:71D15 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D16 a mdhn:IconclassTerm ;
    rdfs:label "elevation and marriage of Joseph (Genesis 41:37-57)"@en ,
               "ارتقای یوسف و ازدواج او"@fa ;
    mdhn:iconclassNotation "71D16" ;
    skos:exactMatch iconclass:71D16 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# ------------------------------------------------------------
# Part II (family reunion and later years)
# ------------------------------------------------------------
mdhn:iconclass71D2 a mdhn:IconclassTerm ;
    rdfs:label "story of Joseph (part II)"@en ,
               "داستان یوسف (بخش دوم)"@fa ;
    mdhn:iconclassNotation "71D2" ;
    skos:exactMatch iconclass:71D2 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D21 a mdhn:IconclassTerm ;
    rdfs:label "Jacob and his family go to Egypt (Genesis 46)"@en ,
               "رفتن یعقوب و خانواده‌اش به مصر"@fa ;
    mdhn:iconclassNotation "71D21" ;
    skos:exactMatch iconclass:71D21 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D2 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D24 a mdhn:IconclassTerm ;
    rdfs:label "Jacob's last days / blessing of the sons (Genesis 47–49)"@en ,
               "روزهای پایانی یعقوب و برکت دادن پسران"@fa ;
    mdhn:iconclassNotation "71D24" ;
    skos:exactMatch iconclass:71D24 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D2 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71D25 a mdhn:IconclassTerm ;
    rdfs:label "Jacob's death (Genesis 49–50)"@en ,
               "درگذشت یعقوب"@fa ;
    mdhn:iconclassNotation "71D25" ;
    skos:exactMatch iconclass:71D25 ;
    mdhn:hasIconclassBroader mdhn:iconclass71D2 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# ------------------------------------------------------------
# Limited-scope (project-specific) extensions – examples
# These are the ones you will most often attach to Persian manuscript canvases
# ------------------------------------------------------------

# The famous scene of the Egyptian women cutting their hands when they see Yusuf
# (very common in Persian painting, less emphasised in pure Iconclass)
mdhn:iconclass71D13_ZulaykhaWomen a mdhn:IconclassTerm ;
    rdfs:label "Zulaykha invites the Egyptian women; they cut their hands at the sight of Yusuf"@en ,
               "دعوت زلیخا از زنان مصری و بریدن دست‌ها از دیدن یوسف"@fa ;
    rdfs:comment "Project-specific refinement of 71D13. Central visual motif in Persian Yusuf va Zulaykha manuscripts."@en ;
    mdhn:iconclassNotation "71D13" ;                 # still inherits the official notation
    mdhn:hasIconclassBroader mdhn:iconclass71D13 ;
    skos:relatedMatch mdhn:Zulaikha_invites_the_egyptian_women ;  # your existing episode
    skos:relatedMatch wd:Q3350827 ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .

# Optional: a broader “Persian Yusuf cycle” grouping if you want a single entry point
mdhn:iconclass71D_PersianCycle a mdhn:IconclassTerm ;
    rdfs:label "Yusuf cycle in Persian manuscript tradition"@en ,
               "چرخه یوسف در سنت نسخه‌های خطی ایرانی"@fa ;
    rdfs:comment "Convenience node that groups the most relevant 71D children for Persian cultural heritage resources."@en ;
    mdhn:hasIconclassBroader mdhn:iconclass71D ;
    skos:relatedMatch mdhn:Yusuf_and_Zulaikha ;
    skos:relatedMatch wd:Q3350827 ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .

#################################################################
# Iconclass hierarchy subset – starting with 71A8
#################################################################

# Parent context (kept for completeness of the hierarchy)


mdhn:iconclass71 a mdhn:IconclassTerm ;
    rdfs:label "Old Testament"@en ;
    mdhn:iconclassNotation "71" ;
    skos:exactMatch iconclass:71 .

# Core concept requested by user
mdhn:iconclass71A8 a mdhn:IconclassTerm ;
    rdfs:label "the story of Cain and Abel (Genesis 4:3-17)"@en ,
               "داستان قابیل و هابیل"@fa ;
    rdfs:comment "Iconclass 71A8 – the story of Cain and Abel (Genesis 4:3-17)"@en ;
    mdhn:iconclassNotation "71A8" ;
    skos:exactMatch iconclass:71A8 ;
    skos:relatedMatch mdhn:Story_of_Cain_and_Abel ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

# Immediate children of 71A8 (so the hierarchy can be extended)
mdhn:iconclass71A81 a mdhn:IconclassTerm ;
    rdfs:label "the sacrifice of Cain and Abel: Abel offers a lamb, Cain usually a sheaf of corn"@en ;
    mdhn:iconclassNotation "71A81" ;
    skos:exactMatch iconclass:71A81 ;
    mdhn:hasIconclassBroader mdhn:iconclass71A8 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71A82 a mdhn:IconclassTerm ;
    rdfs:label "the killing of Abel: Cain slays him with a stone, a club or a jaw-bone, alternatively with a spade or another tool as weapon"@en,
               "قتل هابیل توسط قابیل"@fa  ;
    rdfs:comment """Official Iconclass notation 71A82: 
    the killing of Abel: Cain slays him with a stone, a club or a jaw-bone, 
    alternatively with a spade or another tool as weapon."""@en ;               
    mdhn:iconclassNotation "71A82" ;
    skos:exactMatch iconclass:71A82 ;
    skos:exactMatch <https://iconclass.org/71A82> ;
    mdhn:hasIconclassBroader mdhn:iconclass71A8 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71A821 a mdhn:IconclassTerm ;
    rdfs:label "Abel's death"@en ,
               "مرگ هابیل"@fa ;    
    rdfs:comment "Official Iconclass notation 71A821: Abel's death."@en ;    
    mdhn:iconclassNotation "71A821" ;
    skos:exactMatch <https://iconclass.org/71A821> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A82 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A822 a mdhn:IconclassTerm ;
    rdfs:label "Cain buries Abel"@en ,
               "قابیل هابیل را دفن می‌کند"@fa ;    
    rdfs:comment "Official Iconclass notation 71A822: Cain buries Abel."@en ;    
    mdhn:iconclassNotation "71A822" ;
    skos:exactMatch <https://iconclass.org/71A822> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A82 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A823 a mdhn:IconclassTerm ;
    rdfs:label "Adam and Eve discover the dead body of Abel and grieve over it"@en ,
               "آدم و حوا جسد هابیل را می‌یابند و بر آن سوگواری می‌کنند"@fa ;    
    rdfs:comment "Official Iconclass notation 71A823: Adam and Eve discover the dead body of Abel and grieve over it."@en ;    
    mdhn:iconclassNotation "71A823" ;
    skos:exactMatch <https://iconclass.org/71A823> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A82 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A824 a mdhn:IconclassTerm ;
    rdfs:label "Adam and Eve bury Abel"@en ,
               "آدم و حوا هابیل را دفن می‌کنند"@fa ;    
    rdfs:comment "Official Iconclass notation 71A824: Adam and Eve bury Abel."@en ;    
    mdhn:iconclassNotation "71A824" ;
    skos:exactMatch <https://iconclass.org/71A824> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A82 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .





mdhn:iconclass71A83 a mdhn:IconclassTerm ;
    rdfs:label "the curse and flight of Cain"@en ;
    mdhn:iconclassNotation "71A83" ;
    skos:exactMatch iconclass:71A83 ;
    mdhn:hasIconclassBroader mdhn:iconclass71A8 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass71A84 a mdhn:IconclassTerm ;
    rdfs:label "later life of Cain"@en ;
    mdhn:iconclassNotation "71A84" ;
    skos:exactMatch iconclass:71A84 ;
    mdhn:hasIconclassBroader mdhn:iconclass71A8 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

#################################################################
# Adam & Eve / آدم و حوا (71A)
#################################################################    

mdhn:iconclass71A a mdhn:IconclassTerm ;
    rdfs:label "Genesis from the creation to the expulsion from paradise, and later years of Adam and Eve"@en ;
    mdhn:iconclassNotation "71A" ;
    skos:exactMatch iconclass:71A ;
    mdhn:hasIconclassBroader mdhn:iconclass71 .   # optional higher parent

mdhn:iconclass71A a mdhn:IconclassTerm ;
    rdfs:label "Genesis from the creation to the expulsion from paradise, and later years of Adam and Eve"@en ,
               "آفرینش تا اخراج از بهشت و سال‌های پایانی آدم و حوا"@fa ;
    mdhn:iconclassNotation "71A" ;
    skos:exactMatch iconclass:71A ;
    skos:closeMatch wd:Q70899 ;          # Adam and Eve
    skos:relatedMatch wd:Q70899 ;
    skos:relatedMatch mdhn:Story_of_Adam_and_Eve;
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

### 71A3 – Creation of man; Garden of Eden and selected children

mdhn:iconclass71A3 a mdhn:IconclassTerm ;
    rdfs:label "creation of man; the Garden of Eden"@en ,
               "آفرینش انسان؛ باغ عدن"@fa ;    
    rdfs:comment """Official Iconclass notation 71A3: 
    creation of man; the Garden of Eden (Genesis 1:26 – 2)."""@en ;    
    mdhn:iconclassNotation "71A3" ;
    skos:exactMatch <https://iconclass.org/71A3> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A31 a mdhn:IconclassTerm ;
    rdfs:label "God fashions man from clay"@en ,
               "خداوند انسان را از گل می‌سازد"@fa ;    
    rdfs:comment """Official Iconclass notation 71A31: 
    God forms / fashions man from clay (or dust)."""@en ;    
    mdhn:iconclassNotation "71A31" ;
    skos:exactMatch <https://iconclass.org/71A31> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A3 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A311 a mdhn:IconclassTerm ;
    rdfs:label "the man (Adam) comes to life"@en ,
               "آدم به زندگی می‌آید"@fa ;    
    rdfs:comment """Official Iconclass notation 71A311: 
    the man (Adam) comes to life; usually God stretches out his hand 
    or breathes life into his nostrils."""@en ;    
    mdhn:iconclassNotation "71A311" ;
    skos:exactMatch <https://iconclass.org/71A311> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A31 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A32 a mdhn:IconclassTerm ;
    rdfs:label "God planting the Garden of Eden"@en ,
               "خداوند باغ عدن را می‌کارد"@fa ;    
    rdfs:comment """Official Iconclass notation 71A32: 
    God planting the Garden of Eden."""@en ;    
    mdhn:iconclassNotation "71A32" ;
    skos:exactMatch <https://iconclass.org/71A32> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A3 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A321 a mdhn:IconclassTerm ;
    rdfs:label "creation of Eve"@en ,
               "آفرینش حوا"@fa ;    
    rdfs:comment """Official Iconclass notation 71A321: 
    creation of Eve (from Adam’s rib)."""@en ;    
    mdhn:iconclassNotation "71A321" ;
    skos:exactMatch <https://iconclass.org/71A321> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A32 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A3212 a mdhn:IconclassTerm ;
    rdfs:label "God takes a rib from Adam’s side while he is sleeping"@en ,
               "خداوند دنده‌ای از پهلوی آدم خفته برمی‌دارد"@fa ;    
    rdfs:comment """Official Iconclass notation 71A3212: 
    God takes a rib from Adam’s side while he is sleeping."""@en ;    
    mdhn:iconclassNotation "71A3212" ;
    skos:exactMatch <https://iconclass.org/71A3212> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A321 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A32121 a mdhn:IconclassTerm ;
    rdfs:label "God forms Eve from Adam’s rib"@en ,
               "خداوند حوا را از دنده آدم می‌سازد"@fa ;    
    rdfs:comment """Official Iconclass notation 71A32121: 
    God forms Eve from the rib taken from Adam."""@en ;    
    mdhn:iconclassNotation "71A32121" ;
    skos:exactMatch <https://iconclass.org/71A32121> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A3212 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A32122 a mdhn:IconclassTerm ;
    rdfs:label "Eve is presented to Adam"@en ,
               "حوا به آدم معرفی / نشان داده می‌شود"@fa ;    
    rdfs:comment """Official Iconclass notation 71A32122: 
    Eve is presented to Adam (after her creation)."""@en ;    
    mdhn:iconclassNotation "71A32122" ;
    skos:exactMatch <https://iconclass.org/71A32122> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71A3212 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 71A33 – Adam in the Garden of Eden

mdhn:iconclass71A33 a mdhn:IconclassTerm ;
    rdfs:label "Adam in the Garden of Eden"@en ,
               "آدم در باغ عدن"@fa ;
    
    rdfs:comment """Official Iconclass notation 71A33: 
    Adam in the Garden of Eden."""@en ;
    skos:relatedMatch mdhn:Adam_and_Eve_Iden_Paradise ;       
    mdhn:iconclassNotation "71A33" ;
    skos:exactMatch <https://iconclass.org/71A33> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass71A3 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


mdhn:iconclass71A331 a mdhn:IconclassTerm ;
