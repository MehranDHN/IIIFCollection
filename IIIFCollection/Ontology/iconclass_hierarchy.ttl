    for the flaming nimbus of prophets in Islamic/Persian painting."""@en ;
    
    mdhn:iconclassNotation "22C311" ;
    skos:exactMatch iconclass:22C311 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass22C31 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


