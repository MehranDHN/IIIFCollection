    rdfs:comment """Official Iconclass notation 25FF: 
    fabulous animals (sometimes wrongly called 'grotesques'); 'Mostri' (Ripa).
    Doubled F marks the fabulous counterpart of 25F."""@en ;
    
    mdhn:iconclassNotation "25FF" ;
    skos:exactMatch iconclass:25FF ;
    
    mdhn:hasIconclassBroader mdhn:iconclass25F ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

