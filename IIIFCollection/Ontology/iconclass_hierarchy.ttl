mdhn:iconclass_PropheticBirths a mdhn:IconclassTerm ;
    rdfs:label "Births of Prophets"@en ,
               "تولد پیامبران"@fa ;    
    rdfs:comment """Project-specific higher-level grouping for the birth scenes of prophets 
    in Islamic narrative tradition (and related Biblical figures when treated in the same 
    pictorial cycles). 
    Used as a broader term for limited-scope Iconclass entries such as the Birth of 
    the Prophet Muhammad. 
    No official Iconclass division corresponds exactly to this category."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

mdhn:iconclass_ArabianProphets a mdhn:IconclassTerm ;
    rdfs:label "Arabian Prophets"@en ,
               "پیامبران عرب"@fa ;    
    rdfs:comment """Project-specific higher-level grouping for the Arab prophets 
    of the Islamic tradition (Hūd, Ṣāliḥ, Shuʿayb, and related figures) whose 
    narratives are primarily associated with the Arabian peninsula and appear 
    in Qiṣaṣ al-Anbiyāʾ and related pictorial cycles. 
    No official Iconclass division corresponds to this category."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

