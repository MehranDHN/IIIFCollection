mdhn:iconclass71D a mdhn:IconclassTerm ;
    rdfs:label "Genesis: the story of Joseph"@en ,
               "داستان یوسف (پیدایش)"@fa ;
    rdfs:comment "Iconclass 71D – full story of Joseph (son of Jacob). Central shared Biblical–Quranic narrative; highly relevant for Persian Yusuf va Zulaykha cycles."@en ;
    mdhn:iconclassNotation "71D" ;
    skos:exactMatch iconclass:71D ;
    skos:exactMatch <https://iconclass.org/71D> ;      
    skos:closeMatch wd:Q8423 ;                    # Joseph (son of Jacob)
    skos:relatedMatch wd:Q3350827 ;               # Yusuf and Zulaikha
    skos:relatedMatch mdhn:Yusuf_and_Zulaikha ;   # your existing narrative episode
    mdhn:hasIconclassBroader mdhn:iconclass71 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11H a mdhn:IconclassTerm ;
    rdfs:label "male saints"@en ,
               "قدیسان مرد"@fa ;
    
    rdfs:comment "Iconclass division 11H: male saints (including named individual saints such as Saint George, the Seven Sleepers, etc.)."@en ;    
    mdhn:iconclassNotation "11H" ;
    skos:exactMatch <https://iconclass.org/11H> ;    
    mdhn:hasIconclassBroader mdhn:iconclass11 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .    

mdhn:iconclass_PropheticBirths a mdhn:IconclassTerm ;
    rdfs:label "Births of Prophets"@en ,
               "تولد پیامبران"@fa ;    
    rdfs:comment """Project-specific higher-level grouping for the birth scenes of prophets 
    in Islamic narrative tradition (and related Biblical figures when treated in the same 
    pictorial cycles). 
    Used as a broader term for limited-scope Iconclass entries such as the Birth of 
    the Prophet Muhammad. 
    No official Iconclass division corresponds exactly to this category."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

mdhn:iconclass_ArabianProphets a mdhn:IconclassTerm ;
    rdfs:label "Arabian Prophets"@en ,
               "پیامبران عرب"@fa ;    
    rdfs:comment """Project-specific higher-level grouping for the Arab prophets 
    of the Islamic tradition (Hūd, Ṣāliḥ, Shuʿayb, and related figures) whose 
    narratives are primarily associated with the Arabian peninsula and appear 
    in Qiṣaṣ al-Anbiyāʾ and related pictorial cycles. 
    No official Iconclass division corresponds to this category."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

