


@prefix mdhn:       <http://example.com/mdhn/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix iconclass:  <https://iconclass.org/> .
@prefix wd:         <http://www.wikidata.org/entity/> .
@prefix aat:        <http://vocab.getty.edu/aat/> .

#################################################################
# Joseph / Yusuf cycle – Iconclass 71D hierarchy
# Primed for IIIFDexir association with manuscripts, canvases & content elements
#################################################################

# ------------------------------------------------------------
# Root of the cycle
# ------------------------------------------------------------

### 1 – Religion and Magic

mdhn:iconclass1 a mdhn:IconclassTerm ;
    rdfs:label "Religion and Magic"@en ,
               "دین و جادو"@fa ;
    
    rdfs:comment "Official Iconclass notation 1: Religion and Magic."@en ;
    
    mdhn:iconclassNotation "1" ;
    skos:exactMatch <https://iconclass.org/1> ;
    
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11 a mdhn:IconclassTerm ;
    rdfs:label "Christian religion"@en ,
               "دین مسیحی"@fa ;
    
    rdfs:comment "Official Iconclass notation 11: Christian religion."@en ;
    
    mdhn:iconclassNotation "11" ;
    skos:exactMatch <https://iconclass.org/11> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .







### 11 – Christian religion

mdhn:iconclass11 a mdhn:IconclassTerm ;
    rdfs:label "Christian religion"@en ,
               "دین مسیحی"@fa ;
    
    rdfs:comment """Official Iconclass notation 11: Christian religion.
    Parent of angels (11G), saints (11H), and prophets not in biblical context (11I).
    Use as broader only; pictorial scenes of angels in Islamic manuscripts 
    still take 11G as the visual class."""@en ;
    
    mdhn:iconclassNotation "11" ;
    skos:exactMatch <https://iconclass.org/11> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### 11G – Angels (requested term)

mdhn:iconclass11G a mdhn:IconclassTerm ;
    rdfs:label "angels"@en ,
               "فرشتگان"@fa ;
    
    rdfs:comment """Official Iconclass notation 11G: angels.
    Official visual class for winged celestial messengers.
    Use also for malāʾika in Persian/Islamic painting 
    (birth of the Prophet, Revelation scenes, etc.)."""@en ;
    
    mdhn:iconclassNotation "11G" ;
    skos:exactMatch <https://iconclass.org/11G> ;
    skos:closeMatch <http://www.wikidata.org/entity/Q235113> ;  # angel
    
    mdhn:hasIconclassBroader mdhn:iconclass11 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


### Direct children of 11G

mdhn:iconclass11G1 a mdhn:IconclassTerm ;
    rdfs:label "the nine choirs of angels, hierarchy of angels"@en ,
               "نه گروه فرشتگان، سلسله‌مراتب فرشتگان"@fa ;
    
    rdfs:comment "Official Iconclass notation 11G1: the nine choirs of angels, hierarchy of angels."@en ;
    
    mdhn:iconclassNotation "11G1" ;
    skos:exactMatch <https://iconclass.org/11G1> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11G2 a mdhn:IconclassTerm ;
    rdfs:label "activities of angels (in heaven)"@en ,
               "اعمال فرشتگان (در آسمان)"@fa ;
    
    rdfs:comment "Official Iconclass notation 11G2: activities of angels (in heaven)."@en ;
    
    mdhn:iconclassNotation "11G2" ;
    skos:exactMatch <https://iconclass.org/11G2> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11G3 a mdhn:IconclassTerm ;
    rdfs:label "angels fighting"@en ,
               "نبرد فرشتگان"@fa ;
    
    rdfs:comment "Official Iconclass notation 11G3: angels fighting."@en ;
    
    mdhn:iconclassNotation "11G3" ;
    skos:exactMatch <https://iconclass.org/11G3> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

mdhn:iconclass11G4 a mdhn:IconclassTerm ;
    rdfs:label "specific aspects of angels, e.g. intervening in human affairs"@en ,
               "جنبه‌های خاص فرشتگان، مثلاً دخالت در امور انسان"@fa ;
    
    rdfs:comment """Official Iconclass notation 11G4: 
    specific aspects of angels, e.g. intervening in human affairs.
    Preferred child for angels at the birth of the Prophet, 
    angels handing the infant, or angels addressing a prophet."""@en ;
    
    mdhn:iconclassNotation "11G4" ;
    skos:exactMatch <https://iconclass.org/11G4> ;
    
    mdhn:hasIconclassBroader mdhn:iconclass11G ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .

### 12 – Non-Christian religions

mdhn:iconclass12 a mdhn:IconclassTerm ;
