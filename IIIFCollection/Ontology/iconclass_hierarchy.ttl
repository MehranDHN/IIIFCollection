# Limited-scope extension for the distinct Islamic prophetic figure
mdhn:iconclass71E_Midian a mdhn:IconclassTerm ;
    rdfs:label "Shuaib / Prophet of Midian (Islamic tradition)"@en ,
               "شعیب، پیامبر مدین (سنت اسلامی)"@fa ;
    rdfs:comment """Project-specific extension covering the Quranic prophet Shuaib 
    (identified with or related to Jethro). 
    Captures the distinctive themes of preaching to Midian, 
    fair weights and measures, and the destruction of the people of Midian/Aykah."""@en ;    
    mdhn:iconclassNotation "71E1" ;                 # inherits the nearest official notation
    mdhn:hasIconclassBroader mdhn:iconclass71E1 ;    
    skos:relatedMatch mdhn:Story_of_Shuaib ;                 # back-link to the narrative episode
    skos:relatedMatch wd:Q982867 ;
    skos:relatedMatch wd:Q47680 ;                   # Jethro    
    mdhn:isInExtendedScope "true"^^xsd:boolean .  

#################################################################
# Classical History – Alexander
#################################################################

mdhn:iconclass98B a mdhn:IconclassTerm ;
    rdfs:label "male persons from classical history"@en ,
               "اشخاص مرد از تاریخ کلاسیک"@fa ;
    mdhn:iconclassNotation "98B" ;
    skos:exactMatch mdhn:iconclass98B ;
    mdhn:hasIconclassBroader mdhn:iconclass98 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .
mdhn:iconclass98B_Alexander a mdhn:IconclassTerm ;
    rdfs:label "Alexander the Great"@en ,
               "اسکندر مقدونی / اسکندر کبیر"@fa ;
    rdfs:comment "Official Iconclass notation for the historical and classical legendary figure of Alexander the Great."@en ;    
    mdhn:iconclassNotation "98B(ALEXANDER THE GREAT)" ;       
    mdhn:hasIconclassBroader mdhn:iconclass98B ;   # if you later add the parent
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Iskandar_Dhul_Qarnayn .   

mdhn:iconclass_DhulQarnayn a mdhn:IconclassTerm ;
    rdfs:label "Dhul-Qarnayn (the Two-Horned One)"@en ,
               "ذوالقرنین"@fa ;
    rdfs:comment """Project-specific extension for the Quranic figure Dhul-Qarnayn.
    In Islamic tradition widely identified with Alexander / Iskandar.
    Covers the prophetic and righteous-ruler aspects (building the wall against Gog and Magog, 
    seeking the Water of Life, etc.) that are not fully captured by the classical Iconclass notation."""@en ;    
    # We deliberately do not invent a fake Iconclass notation
    mdhn:iconclassNotation "98B(ALEXANDER THE GREAT)" ;   # nearest official notation    
    mdhn:hasIconclassBroader mdhn:iconclass98B_Alexander ;    
    skos:relatedMatch mdhn:Iskandar_Dhul_Qarnayn ;
    skos:relatedMatch wd:Q8409 ;
    skos:relatedMatch mdhn:iconclass_GogMagogWall ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean . 

mdhn:iconclass_GogMagogWall a mdhn:IconclassTerm ;
    rdfs:label "Wall against Gog and Magog"@en ,
               "سدّ یأجوج و مأجوج"@fa ,
               "Sadd Yaʾjūj wa Maʾjūj"@ar ;    
    rdfs:comment """Project-specific extension for the motif of the iron wall (or rampart) 
    built by Dhul-Qarnayn / Iskandar against the tribes of Gog and Magog (Yaʾjūj wa Maʾjūj).
    This is one of the most distinctive visual and narrative elements of the Islamic Alexander / 
    Dhul-Qarnayn tradition and appears in Persian manuscript painting of the Iskandarnama cycle."""@en ;    
    # Nearest official Iconclass notation (classical Alexander)
    mdhn:iconclassNotation "98B(ALEXANDER THE GREAT)" ;    
    mdhn:hasIconclassBroader mdhn:iconclass_DhulQarnayn ;    
    skos:relatedMatch mdhn:Iskandar_Dhul_Qarnayn ;
    skos:relatedMatch mdhn:iconclass_DhulQarnayn ;
    skos:relatedMatch wd:Q8409 ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean .

mdhn:iconclass71E1_MosesSeventyElders a mdhn:IconclassTerm ;
    rdfs:label "Moses and the seventy elders hearing the voice of God from the clouds"@en ,
               "موسی و هفتاد عالم در حال شنیدن ندای خداوند از میان ابرها"@fa ;    
    rdfs:comment """Project-specific extension for the scene in which Moses (Musa), 
    standing or seated on a rock/mountain and often wearing a prophetic veil, 
    hears the voice of God emerging from the clouds, while the seventy elders 
    (or learned men) lie prostrate below him. 
    Mountains form the background. 
    This composition is particularly characteristic of Ilkhanid manuscript painting 
    (notably the Edinburgh Jāmiʿ al-Tawārīkh) and reflects both Biblical 
    (Exodus 24; Numbers 11) and Islamic narrative traditions."""@en ;
    mdhn:iconclassNotation "71E1" ;                 # story of Moses and Aaron
    mdhn:hasIconclassBroader mdhn:iconclass71E1 ;
    skos:relatedMatch mdhn:iconclass71E1 ;
    skos:relatedMatch wd:Q9077 ;                    # Moses
    skos:relatedMatch mdhn:Moses_and_the_Seventy_Elders ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean .    
    
  mdhn:iconclass71E1124 a mdhn:IconclassTerm ;
    rdfs:label "the finding of Moses: Pharaoh's daughter discovers the child in the river"@en ,
               "یافتن موسی توسط دختر فرعون در رود نیل"@fa ;    
    rdfs:comment """Official Iconclass notation for the discovery of the infant Moses 
    floating in a basket on the Nile by Pharaoh’s daughter and her maidens. 
    In Persian and Islamic manuscript painting the scene often shows Queen Bithia 
    (with long dark hair) and an Israelite nurse of lighter complexion."""@en ;    
    mdhn:iconclassNotation "71E1124" ;
    skos:exactMatch <https://iconclass.org/71E1124> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71E1 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Finding_of_Moses ;
    skos:relatedMatch wd:Q9077 .

mdhn:iconclass71V42 a mdhn:IconclassTerm ;
    rdfs:label "Jonah under the gourd plant"@en ,
               "یونس در زیر بوته کدو / گیاه سایه"@fa ;    
    rdfs:comment """Jonah (Yunus) reclining in the shade of the gourd plant (or vine) 
    that God caused to grow to shelter him after he was cast up by the great fish 
    (Jonah 4:6). 
    The reclining pose is continuous with early Christian iconography. 
    In Persian and Islamic manuscripts the sea creature is frequently shown as a large fish."""@en ;    
    mdhn:iconclassNotation "71V42" ;                # conventional placement under the Jonah cycle
    skos:exactMatch <https://iconclass.org/71V42> ; # adjust if the exact official notation differs    
    mdhn:hasIconclassBroader mdhn:iconclass71V ;
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Jonah_under_the_Gourd ;
    skos:relatedMatch wd:Q2468262 .  

### Official Christian Iconclass term
mdhn:iconclass11H_SevenSleepers a mdhn:IconclassTerm ;
    rdfs:label "the Seven Sleepers of Ephesus"@en ,
               "هفت خفتگان افسس"@fa ;    
    rdfs:comment """Official Iconclass notation for the Seven Sleepers (children) of Ephesus 
    (11H(SEVEN SLEEPERS)). Christian tradition of the youths walled up in a cave under Decius 
    and miraculously awakened under Theodosius II."""@en ;    
    mdhn:iconclassNotation "11H(SEVEN SLEEPERS)" ;
    skos:exactMatch <https://iconclass.org/11H(SEVEN%20SLEEPERS)> ;    
    mdhn:hasIconclassBroader mdhn:iconclass11H ;
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Story_of_Seven_sleepers_of_Ephesus ;
    skos:relatedMatch wd:Q466973 .


### Limited-scope Islamic / Qur’anic layer
mdhn:iconclass_Ashab_al_Kahf a mdhn:IconclassTerm ;
    rdfs:label "Aṣḥāb al-Kahf (Companions of the Cave)"@en ,
               "اصحاب کهف"@fa ;    
    rdfs:comment """Project-specific extension for the Qur’anic version of the Seven Sleepers 
    (Sūrat al-Kahf 18:9–26). Emphasises the Islamic narrative details: the 309-year sleep, 
    the dog (Qiṭmīr), and the alternative location of the cave in Toyug (Central Asia) 
    rather than Ephesus. Used when the painting or text clearly follows the Islamic tradition."""@en ;    
    mdhn:iconclassNotation "11H(SEVEN SLEEPERS)" ;   # nearest official notation
    mdhn:hasIconclassBroader mdhn:iconclass11H_SevenSleepers ;    
    skos:relatedMatch mdhn:Story_of_Seven_sleepers_of_Ephesus ;
    skos:relatedMatch wd:Q466973 ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean .   


### Official Christian Iconclass term (parent)
mdhn:iconclass11H_George a mdhn:IconclassTerm ;
    rdfs:label "Saint George"@en ,
               "قدیس جرجیس / مار جرجس"@fa ;    
    rdfs:comment "Official Iconclass notation for Saint George (11H(GEORGE))."@en ;    
    mdhn:iconclassNotation "11H(GEORGE)" ;
    skos:exactMatch <https://iconclass.org/11H(GEORGE)> ;                       
    mdhn:hasIconclassBroader mdhn:iconclass11H ;
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Jurjis_led_to_the_King_of_Mosul ;
    skos:relatedMatch wd:Q48438 .


### Limited-scope Islamic / prophetic layer
mdhn:iconclass_Jurjis_led_to_King a mdhn:IconclassTerm ;
    rdfs:label "Jurjis led in chains to the King of Mosul"@en ,
               "جرجیس با زنجیر در حال برده‌شدن به نزد پادشاه موصل"@fa ;    
    rdfs:comment """Project-specific extension for the Islamic narrative of the Prophet Jurjis 
    (Jirjis) being led in chains to the King of Mosul after refusing to worship idols. 
    In Islamic tradition he is miraculously protected from the subsequent tortures. 
    This visual formula appears in Ilkhanid painting (notably the Edinburgh Jāmiʿ al-Tawārīkh)."""@en ;    
    mdhn:iconclassNotation "11H(GEORGE)" ;          # nearest official notation
    mdhn:hasIconclassBroader mdhn:iconclass11H_George ;    
    skos:relatedMatch mdhn:Jurjis_led_to_the_King_of_Mosul ;
    skos:relatedMatch wd:Q48438 ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean .       

mdhn:iconclass_Birth_of_Muhammad a mdhn:IconclassTerm ;
    rdfs:label "Birth of the Prophet Muhammad"@en ,
               "تولد پیامبر محمد"@fa ;    
    rdfs:comment """Project-specific extension for the birth of the Prophet Muhammad. 
    The mother reclines on a couch while the newborn is handed to one of two attending angels. 
    The composition is known from Ilkhanid manuscript painting (notably the Edinburgh 
    Jāmiʿ al-Tawārīkh) and later prophetic cycles. 
    No exact official Iconclass notation exists for this Islamic prophetic subject; 
    the term is therefore marked as limited-scope."""@en ;
    mdhn:iconclassNotation "" ;    
    mdhn:hasIconclassBroader mdhn:iconclass_PropheticBirths,mdhn:iconclass_ArabianProphets ;    
    skos:relatedMatch mdhn:Birth_of_the_Prophet_Muhammad ;
    skos:relatedMatch wd:Q9458 ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean .    

### Main official term

mdhn:iconclass71E116 a mdhn:IconclassTerm ;
    rdfs:label "Moses and Aaron confront Pharaoh"@en ,
               "موسی و هارون در برابر فرعون"@fa ;    
    rdfs:comment """Official Iconclass notation 71E116: 
    Moses and Aaron confront Pharaoh (Exodus 5–7:13). 
    Parent term for the miracle of the rod changing into a snake and related scenes."""@en ;    
    mdhn:iconclassNotation "71E116" ;
    skos:exactMatch <https://iconclass.org/71E116> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71E11, mdhn:iconclass_ArabianProphets ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .
mdhn:iconclass71E1164 a mdhn:IconclassTerm ;
    rdfs:label "Moses and Aaron before Pharaoh; Aaron’s rod changes into a snake"@en ,
               "موسی و هارون در برابر فرعون؛ عصا به مار تبدیل می‌شود"@fa ;
    
    rdfs:comment """Official Iconclass notation 71E1164: 
    Moses and Aaron before Pharaoh; Aaron performs the miracle of the rod changing into a snake."""@en ;    
    mdhn:iconclassNotation "71E1164" ;
    skos:exactMatch <https://iconclass.org/71E1164> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71E116 , mdhn:iconclass_ArabianProphets ;
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Staff_becomes_Serpent ;
    skos:relatedMatch wd:Q9077 .


### More specific official child term (swallowing the magicians’ snakes)
mdhn:iconclass71E11641 a mdhn:IconclassTerm ;
    rdfs:label "Aaron’s rod swallows the magicians’ snakes"@en ,
               "عصای هارون مارهای جادوگران را می‌بلعد"@fa ;    
    rdfs:comment """Official Iconclass notation 71E11641: 
    All the magicians summoned by the king turn their rods into snakes, 
    but Aaron’s rod swallows them."""@en ;    
    mdhn:iconclassNotation "71E11641" ;
    skos:exactMatch <https://iconclass.org/71E11641> ;    
    mdhn:hasIconclassBroader mdhn:iconclass71E1164 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean ;    
    skos:relatedMatch mdhn:Staff_becomes_Serpent .    

mdhn:iconclass_Salih_SheCamel a mdhn:IconclassTerm ;
    rdfs:label "Ṣāliḥ leading the she-camel from the mountain"@en ,
               "صالح در حال بیرون آوردن ناقه از کوه"@fa ;
    
    rdfs:comment """Project-specific extension for the miracle of the prophet Ṣāliḥ 
    bringing forth (or leading) the she-camel of God (nāqat Allāh) from the side of a 
    mountain or rock. 
    This is a purely Islamic prophetic subject with no corresponding official Iconclass 
    notation. The visual formula is well-attested in Jāmiʿ al-Tawārīkh and Qiṣaṣ al-Anbiyāʾ 
    manuscripts."""@en ;    
    mdhn:iconclassNotation "" ;
    mdhn:hasIconclassBroader mdhn:iconclass_ArabianProphets ;    
    skos:relatedMatch mdhn:Story_of_Salih_and_the_She_Camel ;
    skos:relatedMatch wd:Q326189 ;    
    mdhn:isInExtendedScope "true"^^xsd:boolean .    


   