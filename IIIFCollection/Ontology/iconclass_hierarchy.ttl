    skos:closeMatch <http://www.wikidata.org/entity/Q7559> ;  # dragon
    skos:relatedMatch mdhn:iconclass25FF411 ;
    
    mdhn:hasIconclassBroader mdhn:iconclass25FF42 ;
    mdhn:isInExtendedScope "false"^^xsd:boolean .


