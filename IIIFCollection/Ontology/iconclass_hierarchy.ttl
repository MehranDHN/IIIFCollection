# ------------------------------------------------------------
# Limited-scope (project-specific) extensions – examples
# These are the ones you will most often attach to Persian manuscript canvases
# ------------------------------------------------------------

# The famous scene of the Egyptian women cutting their hands when they see Yusuf
# (very common in Persian painting, less emphasised in pure Iconclass)
mdhn:iconclass71D13_ZulaykhaWomen a mdhn:IconclassTerm ;
    rdfs:label "Zulaykha invites the Egyptian women; they cut their hands at the sight of Yusuf"@en ,
               "دعوت زلیخا از زنان مصری و بریدن دست‌ها از دیدن یوسف"@fa ;
    rdfs:comment "Project-specific refinement of 71D13. Central visual motif in Persian Yusuf va Zulaykha manuscripts."@en ;
    mdhn:iconclassNotation "71D13" ;                 # still inherits the official notation
    mdhn:hasIconclassBroader mdhn:iconclass71D13 ;
    skos:relatedMatch mdhn:Zulaikha_invites_the_egyptian_women ;  # your existing episode
    skos:relatedMatch wd:Q3350827 ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .

# Optional: a broader “Persian Yusuf cycle” grouping if you want a single entry point
mdhn:iconclass71D_PersianCycle a mdhn:IconclassTerm ;
    rdfs:label "Yusuf cycle in Persian manuscript tradition"@en ,
               "چرخه یوسف در سنت نسخه‌های خطی ایرانی"@fa ;
    rdfs:comment "Convenience node that groups the most relevant 71D children for Persian cultural heritage resources."@en ;
    mdhn:hasIconclassBroader mdhn:iconclass71D ;
    skos:relatedMatch mdhn:Yusuf_and_Zulaikha ;
    skos:relatedMatch wd:Q3350827 ;
    mdhn:isInExtendedScope "true"^^xsd:boolean .

