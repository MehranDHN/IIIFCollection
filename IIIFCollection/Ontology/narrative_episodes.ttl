    mdhn:charactersInvolved mdhn:Saadi_Shirazi ;
    mdhn:isPartOf mdhn:Golestan_Bab_2_Morals_of_Dervishes ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Dervish_Steals_a_Blanket a mdhn:NarrativeEpisode ;
    rdfs:label "The Dervish Who Stole a Blanket"@en , "درویش و گلیم دزدیده‌شده"@fa ;
    rdfs:comment """Bab 2, hikayat 14. A needy dervish steals a friend's blanket; the judge orders his hand cut off; the owner intercedes, arguing the poor own nothing and the property is as waqf."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_2_Morals_of_Dervishes ;
    mdhn:icWikiDataURL "" .


### Bab 3 — The Excellence of Contentment (فضیلت قناعت)

mdhn:Golestan_Bab_3_Excellence_of_Contentment a mdhn:NarrativeEpisode ;
    rdfs:label "Golestan Chapter 3: The Excellence of Contentment"@en , "گلستان باب سوم: در فضیلت قناعت"@fa ;
    rdfs:comment "Third bab. Anecdotes on qana'at, poverty accepted with dignity, and the folly of ill-prepared ambition (about 29 hikayat)."@en ;
    mdhn:isPartOf mdhn:Golestan_of_Saadi ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Two_Brothers_Vizier_and_Dervish a mdhn:NarrativeEpisode ;
    rdfs:label "Two Brothers, the Vizier and the Dervish"@en , "دو برادر وزیر و درویش"@fa ;
    rdfs:comment """A wealthy vizier urges his dervish brother to take office; the dervish prefers contentment to the anxieties of power."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_3_Excellence_of_Contentment ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Unprepared_Traveller a mdhn:NarrativeEpisode ;
    rdfs:label "The Unprepared Traveller"@en , "ورزشکار سفرنادیده"@fa ;
    rdfs:comment """Bab 3, hikayat 28. An athlete down on his luck wishes to travel; his father warns him against a journey for which he is unequipped. One of the longest hikayat in the book."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_3_Excellence_of_Contentment ;
    mdhn:icWikiDataURL "" .


### Bab 4 — The Advantages of Silence (فواید خاموشی)

mdhn:Golestan_Bab_4_Advantages_of_Silence a mdhn:NarrativeEpisode ;
    rdfs:label "Golestan Chapter 4: The Advantages of Silence"@en , "گلستان باب چهارم: در فواید خاموشی"@fa ;
    rdfs:comment "Fourth and shortest narrative bab (about 14 hikayat) on when speech is a fault and silence a virtue."@en ;
    mdhn:isPartOf mdhn:Golestan_of_Saadi ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Silence_of_the_Wise a mdhn:NarrativeEpisode ;
    rdfs:label "The Silence of the Wise"@en , "خاموشی دانا"@fa ;
    rdfs:comment """Representative hikayat of Bab 4: a learned man remains silent in a gathering; when pressed he observes that a fool is known by his tongue and a wise man sometimes by his silence."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_4_Advantages_of_Silence ;
    mdhn:icWikiDataURL "" .


### Bab 5 — Love and Youth (عشق و جوانی)

mdhn:Golestan_Bab_5_Love_and_Youth a mdhn:NarrativeEpisode ;
    rdfs:label "Golestan Chapter 5: On Love and Youth"@en , "گلستان باب پنجم: در عشق و جوانی"@fa ;
    rdfs:comment "Fifth bab. Anecdotes of lovers, schoolboys, judges and the disorders of passion (about 21 hikayat). Heavily illustrated in Timurid and Mughal copies."@en ;
    mdhn:isPartOf mdhn:Golestan_of_Saadi ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Night_Conversation_in_the_Garden a mdhn:NarrativeEpisode ;
    rdfs:label "Night Conversation of the Lovers in a Garden"@en , "مناجات و گفتگوی عاشقانه در باغ"@fa ;
    rdfs:comment """Garden / night-conversation scene belonging to the love-and-youth cycle of the Golestan, the visual counterpart of the preface garden miniature."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_5_Love_and_Youth ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Qazi_of_Hamadan a mdhn:NarrativeEpisode ;
    rdfs:label "The Qazi of Hamadan"@en , "قاضی همدان"@fa ;
    rdfs:comment """Famous (and often illustrated) hikayat of Bab 5: the qazi of Hamadan is discovered in a scandalous night assembly and answers his accusers with wit."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_5_Love_and_Youth ;
    mdhn:icWikiDataURL "" .


### Bab 6 — Weakness and Old Age (ضعف و پیری)

mdhn:Golestan_Bab_6_Weakness_and_Old_Age a mdhn:NarrativeEpisode ;
    rdfs:label "Golestan Chapter 6: On Weakness and Old Age"@en , "گلستان باب ششم: در ضعف و پیری"@fa ;
    rdfs:comment "Sixth bab. Short cycle (about 9 hikayat) on frailty, the mismatch of age and desire, and counsel to the old."@en ;
    mdhn:isPartOf mdhn:Golestan_of_Saadi ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Old_Man_and_Young_Bride a mdhn:NarrativeEpisode ;
    rdfs:label "The Old Man and the Young Bride"@en , "پیر و عروس جوان"@fa ;
    rdfs:comment """An old man takes a young wife; she complains of his weakness. A standard subject for Golestan illustration of Bab 6."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_6_Weakness_and_Old_Age ;
    mdhn:icWikiDataURL "" .


### Bab 7 — The Effects of Education (تأثیر تربیت)

mdhn:Golestan_Bab_7_Effects_of_Education a mdhn:NarrativeEpisode ;
    rdfs:label "Golestan Chapter 7: On the Effects of Education"@en , "گلستان باب هفتم: در تأثیر تربیت"@fa ;
    rdfs:comment "Seventh bab. Anecdotes on teaching, innate disposition versus training, schoolmasters and princely education (about 20 hikayat)."@en ;
    mdhn:isPartOf mdhn:Golestan_of_Saadi ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Young_Wrestler_and_Old_Master a mdhn:NarrativeEpisode ;
    rdfs:label "The Young Wrestler and the Old Master"@en , "جوان کشتی‌گیر و پهلوان پیر"@fa ;
    rdfs:comment """A pupil challenges his aged teacher before the king; the old master throws him with a hold he had never taught. Lesson: the teacher withholds the last trick."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_7_Effects_of_Education ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Prince_and_Slave_Educated_Together a mdhn:NarrativeEpisode ;
    rdfs:label "The Prince and the Slave Educated Together"@en , "شاهزاده و غلام همدرس"@fa ;
    rdfs:comment """A king has a slave-boy educated with his son; the slave remains base and the prince noble. Saadi's argument that training cannot overwrite nature."""@en ;
    mdhn:isPartOf mdhn:Golestan_Bab_7_Effects_of_Education ;
    mdhn:icWikiDataURL "" .


### Bab 8 — Rules for Conduct in Life (آداب صحبت)

mdhn:Golestan_Bab_8_Rules_of_Conduct a mdhn:NarrativeEpisode ;
    rdfs:label "Golestan Chapter 8: On Rules for Conduct in Life"@en , "گلستان باب هشتم: در آداب صحبت"@fa ;
    rdfs:comment """Eighth bab. Mix of short hikayat and aphorisms on manners, speech and society, closing with the long 'Debate of Saadi with the Claimant'."""@en ;
    mdhn:isPartOf mdhn:Golestan_of_Saadi ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Debate_with_the_Claimant a mdhn:NarrativeEpisode ;
    rdfs:label "Saadi's Debate with the Claimant"@en , "جدال سعدی با مدعی"@fa ;
    rdfs:comment """The long closing disputation of Bab 8: Saadi argues with a rich, proud interlocutor on wealth, poverty, contentment and the true gentleman. Often treated as a set piece in manuscripts."""@en ;
    mdhn:charactersInvolved mdhn:Saadi_Shirazi ;
    mdhn:isPartOf mdhn:Golestan_Bab_8_Rules_of_Conduct ;
    mdhn:icWikiDataURL "" .

# =============================================================================
# DRAFT 2 — Shahnameh tree
# Rule: reigns are the ONLY top-level branches under Shahnameh.
#
# A dastan is not itself a reign. It is a plot arc that may START in one
# padshahi and CONTINUE in the next. Each SCENE has two parents:
#   1. the dastan it belongs to          (ZahhakStory)
#   2. the reign in which the event falls (Kingdom_of_Jamshid OR KingdomOfZahhak)
#
# Worked example — ZahhakStory begins while Jamshid is still king:
#   Kingdom_of_Jamshid                KingdomOfZahhak
#     Zahhak kills Mardas               Zahhak Enthroned
#     Iblis kisses the shoulders        Daughters of Jamshid
#     Pride and fall of Jamshid         Nightmare / Kaveh / chaining
#     Sawing of Jamshid
#                    \                 /
#                     \               /
#                      ZahhakStory     (the arc, not a top-level branch)
#
#   Shahnameh
#     └── Kingdom_*                              ← top-level branch
#           ├── scene-in-this-reign
#           │     also isPartOf SomeStory
#           └── SomeStory                        ← nested under every reign it occupies
#
# LIVE FILE CLEANUP (do this when merging; append-only cannot delete)
#   Retract:  ZahhakStory      isPartOf Shahnameh
#   Retract:  RostamStory      isPartOf Shahnameh
#   Retract:  Siyavash_Story   isPartOf Shahnameh
#   Retract:  ZalAndRudaba     isPartOf Shahnameh
#   Retract:  DavazdahRokh     isPartOf Shahnameh
#   Retract:  KingdomOfZahhak  isPartOf ZahhakStory
#   Retract:  Esfandiyar_Slays_Nowzar / Funeral_of_Isfandiyar  isPartOf Shahnameh
# Prefer Kingdom_of_Fereydun over the duplicate KingdomOfFaridun.
# =============================================================================


# ===========================================================================
# PISHDADIAN REIGNS  (top-level branches 1–10)
# ===========================================================================

# --- 1. Keyumars -----------------------------------------------------------
# existing: Kingdom_of_Keyumars, KeyumarsEnthroned,
#           Siamak_Was_Slayin_By_Div, Hushang_Fight_Black_Div

# --- 2. Hushang ------------------------------------------------------------
# existing: Kingdom_of_Hushang, Hushang_Enthroned, Hushang_In_Feast_Of_Sada

# --- 3. Tahmuras -----------------------------------------------------------
# existing: KingdomOfTahmuras, Tahmuras_Enthroned, Tahmuras_Defeating_the_Divs

# --- 4. Jamshid ------------------------------------------------------------
# Own reign scenes, plus the OPENING of ZahhakStory (Zahhak is not yet king).


