mdhn:Noah_and_Family_on_the_Ark a mdhn:NarrativeEpisode ;
    rdfs:label "Noah and his family on the ark"@en ,
               "نوح و خانواده‌اش بر روی کشتی"@fa ;    
    rdfs:comment """Narrative episode corresponding to the painting that depicts 
    Noah and his family on the deck of the ark during the Flood. 
    This scene belongs to the broader story of Noah and the Flood 
    (Genesis 7–8 / Quranic parallels in Surah Hud and Surah Nuh)."""@en ;    
    mdhn:charactersInvolved mdhn:Noah ,
                            mdhn:Kanan ;   
    mdhn:isPartOf mdhn:Story_of_Noah ;    
    skos:exactMatch mdhn:iconclass71B331 ; 
    skos:relatedMatch <http://www.wikidata.org/entity/Q126553> ;  # Noah's Ark
    skos:relatedMatch <http://www.wikidata.org/entity/Q81422> ; # Noah    
    mdhn:icWikiDataURL "" .


mdhn:Story_of_Shuaib a mdhn:NarrativeEpisode ;
    rdfs:label "Story of Shuaib"@en , "داستان شعيب"@fa , "Shuʿayb"@ar ;
    rdfs:comment """Prophet sent to the people of Midian (Madyan) and the Companions of the Wood (Aṣḥāb al-Aykah). 
    Known in Islamic tradition as the 'Orator of the Prophets'. 
    Widely identified with the Biblical Jethro (father-in-law of Moses), though some traditions distinguish them. 
    His message focused on monotheism and fair dealing in weights and measures."""@en ;    
    mdhn:icWikiDataURL "https://www.wikidata.org/wiki/Q982867" ;    
    mdhn:charactersInvolved mdhn:Shuayb, mdhn:Moses , mdhn:Zipporah ;
    mdhn:isPartOf  mdhn:Jewish_Mythology, mdhn:Islamic_Mythology ;    
    skos:relatedMatch mdhn:iconclass71E1 ;          # story of Moses
    skos:broadMatch   mdhn:iconclass71E1 ;
    skos:relatedMatch mdhn:iconclass71E_Midian ;    # limited-scope extension (see below)    
    skos:relatedMatch wd:Q982867 ;
    skos:relatedMatch wd:Q47680 .                   # Jethro (Biblical figure) – if you want the cross-tradition link

mdhn:Story_of_Cain_and_Abel a mdhn:NarrativeEpisode ;
    rdfs:label "Story of Cain and Abel"@en ,
               "قابیل و هابیل"@fa ,
               "Cain and Abel"@ar ;
    rdfs:comment """The story of the first two sons of Adam and Eve. 
    Cain (farmer) and Abel (shepherd) offer sacrifices; God accepts Abel’s offering. 
    Cain kills Abel out of jealousy — the first murder in Biblical and Quranic tradition. 
    Widely illustrated in Persian Qisas al-Anbiya manuscripts and related prophetic cycles."""@en ;    
    mdhn:icWikiDataURL "https://www.wikidata.org/wiki/Q717996" ;
    mdhn:charactersInvolved mdhn:Cain , mdhn:Abel , mdhn:Adam , mdhn:Eve ;
    mdhn:isPartOf mdhn:Christian_Mythology, mdhn:Islamic_Mythology, mdhn:Qisas_al_Anbiya, mdhn:Jewish_Mythology, mdhn:Story_of_Adam_and_Eve  ;               
    skos:exactMatch   mdhn:iconclass71A8 ;        # the story of Cain and Abel
    skos:closeMatch   mdhn:iconclass71A8 ;
    skos:relatedMatch mdhn:iconclass71A81 ;       # the sacrifice
    skos:relatedMatch mdhn:iconclass71A82 ;       # the killing of Abel
    skos:relatedMatch mdhn:iconclass71A83 ;       # the curse and flight of Cain
    skos:relatedMatch wd:Q717996 .   

### Cain and Abel – Killing of Abel and related scenes

mdhn:Killing_of_Abel a mdhn:NarrativeEpisode ;
    rdfs:label "The Killing of Abel"@en ,
               "قتل هابیل"@fa ,
               "Cain slays Abel"@en ;    
    rdfs:comment """Cain kills his brother Abel. 
    In traditional iconography Cain uses a stone, a club, a jaw-bone, 
    a spade or another tool as the weapon (Genesis 4:8). 
    This is the central act of the Cain and Abel narrative."""@en ;    
    mdhn:icWikiDataURL "https://www.wikidata.org/wiki/Q717996" ;    
    mdhn:charactersInvolved mdhn:Cain ,
                            mdhn:Abel ;    
    mdhn:isPartOf mdhn:Story_of_Cain_and_Abel ;    
    skos:exactMatch   mdhn:iconclass71A82 ;
    skos:relatedMatch wd:Q717996 .


