    mdhn:isPartOf mdhn:Golestan_Bab_2_Morals_of_Dervishes ;
    mdhn:icWikiDataURL "" .

mdhn:Golestan_Saadi_Captured_by_Franks a mdhn:NarrativeEpisode ;
    rdfs:label "Saadi Captured by the Franks"@en , "اسارت سعدی به دست فرنگیان"@fa ;
